{% comment %}
  Precision Control Deck Header
  - 20% Logo | 60% Nav | 20% Utilities
  - Transparent to White on scroll
  - Redline hover effects
{% endcomment %}

<script src="{{ 'header-precision.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign header_is_transparent = false
  if template.name == 'index'
    assign header_is_transparent = true
  endif
-%}

{% if header_is_transparent %}
  <style>
    #shopify-section-{{ section.id }} {
      margin-bottom: -80px;
      position: relative;
      z-index: 1000;
    }
  </style>
{% endif %}

<header-precision class="fixed top-[36px] left-0 w-full z-[2000] transition-all duration-300 group {% unless header_is_transparent %}scrolled{% endunless %}" data-transparent="{{ header_is_transparent }}">
  <!-- The Alert Line is rendered separately above this, or we can include it here if we want it part of the sticky group -->
  
  <div class="header-container h-[80px] px-4 lg:px-8 flex items-center justify-between transition-colors duration-300 bg-transparent group-[.scrolled]:bg-white group-[.scrolled]:shadow-sm">
    
    <!-- 1. Mobile Hamburger (Visible on Mobile Only) -->
    <div class="lg:hidden flex-none w-12">
      <button type="button" class="text-white group-[.scrolled]:text-[#111111] p-2" onclick="document.getElementById('mobile-menu-drawer').showModal()">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    <!-- 2. Logo (Left 20%) -->
    <div class="flex-none lg:w-[20%] flex items-center justify-center lg:justify-start">
      <a href="/" id="header-logo-link" class="text-2xl font-bold tracking-tighter uppercase transition-colors duration-300 text-white group-[.scrolled]:text-[#111111]">
        <span id="header-logo-text">{{ shop.name }}<span class="text-[#CC0000] opacity-0 group-[.scrolled]:opacity-100 transition-opacity duration-300">.</span></span>
      </a>
    </div>

    <script>
      (function() {
        const CACHE_KEY = 'skm_shop_profile_v1';
        const CACHE_TTL_MS = 24 * 60 * 60 * 1000;

        const readCache = () => {
          try {
            const raw = localStorage.getItem(CACHE_KEY);
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            if (!parsed || !parsed.savedAt || !parsed.profile) return null;
            if (Date.now() - parsed.savedAt > CACHE_TTL_MS) return null;
            return parsed.profile;
          } catch (e) { return null; }
        };

        const writeCache = (profile) => {
          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify({ savedAt: Date.now(), profile: profile }));
          } catch (e) { /* quota; ignore */ }
        };

        const applyLogo = (logoUrl) => {
          if (!logoUrl) return;
          const logoLink = document.getElementById('header-logo-link');
          if (logoLink) {
            const existingImg = logoLink.querySelector('img');
            if (!existingImg || existingImg.src !== logoUrl) {
              const img = document.createElement('img');
              img.src = logoUrl;
              img.alt = '{{ shop.name }}';
              img.style.height = '36px';
              img.style.width = 'auto';
              img.style.objectFit = 'contain';
              logoLink.innerHTML = '';
              logoLink.appendChild(img);
            }
          }

          let favicon = document.querySelector('link[rel="icon"]') || document.querySelector('link[rel="shortcut icon"]');
          if (!favicon) {
            favicon = document.createElement('link');
            favicon.rel = 'icon';
            document.head.appendChild(favicon);
          }
          if (favicon.href !== logoUrl) favicon.href = logoUrl;

          const appleTouchIcon = document.querySelector('link[rel="apple-touch-icon"]');
          if (appleTouchIcon && appleTouchIcon.href !== logoUrl) appleTouchIcon.href = logoUrl;
        };

        // Apply cached logo synchronously — no flicker on repeat visits.
        const cached = readCache();
        if (cached && cached.logo) applyLogo(cached.logo);

        // Refresh in the background; update only if the URL changed.
        const refresh = async () => {
          try {
            const res = await fetch('https://skm-inventory-api.miaotingshuo.workers.dev/shop/profile');
            if (!res.ok) return;
            const data = await res.json();
            writeCache(data);
            if (data.logo && data.logo.trim() !== '' && (!cached || cached.logo !== data.logo)) {
              applyLogo(data.logo);
            }
          } catch (e) {
            console.error('Logo update failed:', e);
          }
        };
        refresh();
      })();
    </script>

    <!-- 3. Navigation (Center 60%) -->
    <nav class="max-lg:hidden flex flex-1 justify-center items-center h-full w-full">
      <ul class="flex gap-8 h-full items-center">
        {%- comment -%} Direct access fallback to 'main-menu' if section settings fail {%- endcomment -%}
        {%- assign menu_links = linklists[section.settings.menu].links -%}
        {%- if menu_links == blank -%}
          {%- assign menu_links = linklists['main-menu'].links -%}
        {%- endif -%}

        {%- for link in menu_links -%}
            <li class="h-full flex items-center group/link relative px-2">
              <a href="{{ link.url }}" data-title="{{ link.title | downcase }}" class="text-[13px] font-medium uppercase tracking-[0.2em] text-white group-[.scrolled]:text-[#111111] transition-colors duration-300 block">
                {{ link.title }}
              </a>
              <span class="absolute bottom-[28px] left-0 h-[2px] bg-[#CC0000] w-0 transition-all duration-300 group-hover/link:w-full"></span>
              
              {%- if link.links != blank -%}
                <div class="absolute top-full left-0 w-screen -ml-[calc(50vw-50%)] bg-white shadow-xl opacity-0 invisible group-hover/link:opacity-100 group-hover/link:visible transition-all duration-300 border-t border-gray-100">
                  <div class="max-w-7xl mx-auto px-8 py-12 grid grid-cols-4 gap-8">
                    {%- for child_link in link.links -%}
                      <div>
                        <h4 class="font-bold text-[#111111] uppercase tracking-wider mb-4 text-sm">{{ child_link.title }}</h4>
                        <ul class="space-y-3">
                          {%- for grandchild_link in child_link.links -%}
                            <li>
                              <a href="{{ grandchild_link.url }}" class="text-gray-500 hover:text-[#CC0000] transition-colors text-sm block">{{ grandchild_link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endfor -%}
                    <div class="bg-gray-50 flex items-center justify-center p-6">
                       <div class="text-center">
                          <span class="text-[#CC0000] font-bold uppercase text-xs tracking-widest mb-2 block">Featured</span>
                          <p class="text-gray-900 font-bold">Performance Series</p>
                       </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- 4. Utilities (Right 20%) -->
    <div class="flex-none w-auto lg:w-[20%] flex items-center justify-end gap-4 lg:gap-6">
      
      <!-- Search (Lens) -->
      <button type="button" class="text-white group-[.scrolled]:text-[#111111] hover:text-[#CC0000] transition-colors" onclick="document.getElementById('search-drawer').showModal()">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </button>

      <!-- B2B Badge -->
      {% if customer %}
        <!-- DEBUG TAGS: {{ customer.tags | join: ',' }} -->
        <script>
        </script>
        
        {% assign is_b2b = false %}
        {% for tag in customer.tags %}
          {% assign tag_downcase = tag | downcase | strip %}
          {% if tag_downcase == 'b2b' or tag_downcase == 'wholesale' or tag_downcase == 'business' %}
            {% assign is_b2b = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        
        <!-- DEBUG IS_B2B: {{ is_b2b }} -->

        {% if is_b2b %}
          <div class="flex items-center justify-center px-3 py-1 border border-[#CC0000] bg-[#CC0000]/10 rounded-full animate-pulse hover:animate-none group cursor-default whitespace-nowrap">
            <span class="w-1.5 h-1.5 bg-[#CC0000] rounded-full mr-2"></span>
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#CC0000]">BUSINESS</span>
          </div>
        {% endif %}
      {% endif %}

      <!-- Account (Driver) -->
      {% if customer %}
        <details class="relative group/user-menu">
          <summary class="list-none cursor-pointer flex items-center justify-center w-8 h-8 rounded-full bg-[#111111] text-white font-bold text-xs border border-white/20 group-[.scrolled]:border-black/10 transition-colors duration-300 hover:bg-[#CC0000] hover:border-[#CC0000] [&::-webkit-details-marker]:hidden">
            {{ customer.first_name | first }}{{ customer.last_name | first }}
          </summary>
          <div class="absolute right-0 top-full mt-2 w-48 bg-white shadow-xl border border-gray-100 rounded-sm overflow-hidden z-50 p-2">
              <div class="px-4 py-3 border-b border-gray-50 mb-2">
                  <p class="text-sm font-bold text-gray-900 truncate">{{ customer.name }}</p>
                  <p class="text-xs text-gray-500 truncate">{{ customer.email }}</p>
              </div>
              <a href="/account" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#CC0000] rounded-sm">My Profile</a>
              <a href="/account/addresses" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#CC0000] rounded-sm">Addresses</a>
              <a href="{{ routes.account_logout_url }}?return_url={{ routes.account_login_url | append: '?logged_out=true' | url_encode }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-[#CC0000] border-t border-gray-50 mt-2 pt-2 rounded-sm">Sign out</a>
          </div>
        </details>
      {% else %}
        {% if request.design_mode %}
          <button type="button" class="block text-white group-[.scrolled]:text-[#111111] hover:text-[#CC0000] transition-colors relative group/account">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <span class="absolute top-full right-0 mt-2 bg-black text-white text-[10px] uppercase font-bold px-2 py-1 opacity-0 group-hover/account:opacity-100 transition-opacity whitespace-nowrap hidden lg:block">
              Login disabled in editor
            </span>
          </button>
        {% else %}
          <a href="/account/login" class="block text-white group-[.scrolled]:text-[#111111] hover:text-[#CC0000] transition-colors relative group/account">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <span class="absolute top-full right-0 mt-2 bg-black text-white text-[10px] uppercase font-bold px-2 py-1 opacity-0 group-hover/account:opacity-100 transition-opacity whitespace-nowrap hidden lg:block">
              Login / Join
            </span>
          </a>
        {% endif %}
      {% endif %}

      <!-- Cart (Payload) -->
      <a href="{{ routes.cart_url }}" class="text-white group-[.scrolled]:text-[#111111] hover:text-[#CC0000] transition-colors relative" id="cart-icon-bubble">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        <span 
          id="precision-cart-count" 
          class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-[#CC0000] text-[9px] font-bold text-white transition-transform duration-200 {% if cart.item_count == 0 %}hidden{% endif %}"
          data-cart-count="{{ cart.item_count }}"
        >
          {{ cart.item_count }}
        </span>
      </a>

    </div>
  </div>
  
  <!-- Category Navigation Bar (Type Selection) - Inside header for unified movement -->
  <nav id="category-nav" class="w-full z-[1999] nav-hidden">
    <div class="max-w-[1920px] mx-auto px-4 lg:px-8">
      <div class="flex items-center justify-center gap-2 h-10 overflow-x-auto scrollbar-hide">
        <!-- Vehicle Badge (shown when vehicle selected, BUT hidden on collection page) -->
        <div id="vehicle-badge" class="hidden flex items-center gap-2 mr-2">
          <span class="flex items-center gap-1.5 px-3 py-1 bg-[#CC0000]/20 border border-[#CC0000]/40 rounded-full text-xs font-medium text-white">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 17h14M7 13h.01M17 13h.01M6 9h12l-1.5-4.5a1 1 0 00-.95-.5H8.45a1 1 0 00-.95.5L6 9z"/></svg>
            <span id="vehicle-name">Vehicle</span>
          </span>
          <button id="btn-clear-vehicle" class="text-gray-400 hover:text-white p-1 rounded-full hover:bg-white/10" title="Clear Vehicle">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div id="category-links" class="flex items-center gap-1 lg:gap-2">
          <span class="text-[10px] text-gray-500 uppercase tracking-wider">Loading...</span>
        </div>
      </div>
    </div>
  </nav>
</header-precision>

<script>
(function() {
  const API_BASE = 'https://skm-inventory-api.miaotingshuo.workers.dev';
  const VEHICLE_KEY = 'skm_garage_vehicle';
  
  // Get saved vehicle from localStorage
  const getVehicle = () => {
    try {
      return JSON.parse(localStorage.getItem(VEHICLE_KEY) || 'null');
    } catch { return null; }
  };
  
  // Build vehicle display name
  const getVehicleName = (v) => {
    if (!v) return '';
    return `${v.year} ${v.make} ${v.model}${v.submodel ? ' ' + v.submodel : ''}`;
  };
  
  // Clear vehicle and redirect
  const clearVehicle = () => {
    localStorage.removeItem(VEHICLE_KEY);
    window.location.href = '/collections/all';
  };
  
  const CATEGORIES_TTL_MS = 24 * 60 * 60 * 1000;
  const cacheKeyFor = (vehicleId) => `skm_categories_v1_${vehicleId || 'none'}`;

  const readCategoriesCache = (vehicleId) => {
    try {
      const raw = localStorage.getItem(cacheKeyFor(vehicleId));
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.savedAt || !parsed.data) return null;
      if (Date.now() - parsed.savedAt > CATEGORIES_TTL_MS) return null;
      return parsed.data;
    } catch (e) { return null; }
  };

  const writeCategoriesCache = (vehicleId, data) => {
    try {
      localStorage.setItem(cacheKeyFor(vehicleId), JSON.stringify({ savedAt: Date.now(), data: data }));
    } catch (e) { /* quota; ignore */ }
  };

  const renderCategories = (data, vehicle) => {
    const container = document.getElementById('category-links');
    if (!container) return;

    if (!data || !data.data || data.data.length === 0) {
      container.innerHTML = vehicle
        ? '<span class="text-xs font-semibold text-[#CC0000] bg-red-500/10 px-3 py-1 rounded-full border border-red-500/30 no-parts-pulse">⚠ No category parts for this vehicle</span>'
        : '<a href="/collections/all" class="category-link">All Products</a>';
      return;
    }

    let html = '';
    if (vehicle && vehicle.id) {
      const vehicleFilter = `filter.p.m.custom.fits_vehicles=${encodeURIComponent(vehicle.id)}`;
      html += `<a href="/collections/all?${vehicleFilter}" class="category-link active">All</a>`;
      data.data.forEach(cat => {
        const url = `/collections/all?${vehicleFilter}&type=${encodeURIComponent(cat.name)}`;
        html += `<a href="${url}" class="category-link" data-type="${cat.name}">${cat.name} <span class="text-[9px] opacity-60">(${cat.count})</span></a>`;
      });
    } else {
      html += '<a href="/collections/all" class="category-link active">All</a>';
      data.data.forEach(cat => {
        const url = `/collections/all?type=${encodeURIComponent(cat.name)}`;
        html += `<a href="${url}" class="category-link" data-type="${cat.name}">${cat.name} <span class="text-[9px] opacity-60">(${cat.count})</span></a>`;
      });
    }

    container.innerHTML = html;

    const urlParams = new URLSearchParams(window.location.search);
    const activeType = urlParams.get('type');
    if (activeType) {
      container.querySelectorAll('.category-link').forEach(link => {
        link.classList.remove('active');
        if (link.dataset.type === activeType) link.classList.add('active');
      });
    }
  };

  const updateVehicleBadge = (vehicle) => {
    const vehicleBadge = document.getElementById('vehicle-badge');
    const vehicleName = document.getElementById('vehicle-name');
    const clearBtn = document.getElementById('btn-clear-vehicle');
    const isCollectionPage = window.location.pathname.includes('/collections/');

    if (vehicle && vehicleBadge) {
      if (!isCollectionPage) {
        vehicleBadge.classList.remove('hidden');
        vehicleBadge.classList.add('flex');
      } else {
        vehicleBadge.classList.add('hidden');
        vehicleBadge.classList.remove('flex');
      }
      if (vehicleName) vehicleName.textContent = getVehicleName(vehicle);
      if (clearBtn) clearBtn.addEventListener('click', clearVehicle);
    }
  };

  const loadCategories = async () => {
    const vehicle = getVehicle();
    const vehicleId = vehicle && vehicle.id ? vehicle.id : '';

    updateVehicleBadge(vehicle);

    // 1. Render synchronously from cache if fresh — no "Loading…" placeholder.
    const cached = readCategoriesCache(vehicleId);
    if (cached) renderCategories(cached, vehicle);

    // 2. Fetch fresh in the background. Re-render only if the payload differs
    //    so we don't churn DOM on every visit when nothing changed.
    try {
      let apiUrl = `${API_BASE}/categories`;
      if (vehicleId) apiUrl += `?vehicleId=${encodeURIComponent(vehicleId)}`;
      const res = await fetch(apiUrl);
      if (!res.ok) return;
      const data = await res.json();
      writeCategoriesCache(vehicleId, data);
      if (!cached || JSON.stringify(cached) !== JSON.stringify(data)) {
        renderCategories(data, vehicle);
      }
    } catch (e) {
      console.error('Failed to load categories:', e);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadCategories);
  } else {
    loadCategories();
  }
  })();

  // Catalog Hover Logic for Category Nav
  (function() {
    const catNav = document.getElementById('category-nav');
    // We need to wait for DOM or standard load
    const initNav = () => {
      const catalogLink = document.querySelector('a[data-title="catalog"]');
      if (!catNav || !catalogLink) return;

      const isCollectionAll = window.location.pathname === '/collections/all';

      // Function to show
      const show = () => {
        catNav.classList.remove('nav-hidden');
        catNav.classList.add('nav-visible');
      };

      // Function to hide
      const hide = () => {
        if (isCollectionAll) return; // Lock open on /collections/all
        catNav.classList.remove('nav-visible');
        catNav.classList.add('nav-hidden');
      };

      // Initial State
      if (isCollectionAll) {
        show();
      } else {
        catNav.classList.add('nav-hidden');
      }

      // Hover Events with Debounce
      let timeout;
      const cancelHide = () => clearTimeout(timeout);
      const scheduleHide = () => {
        timeout = setTimeout(hide, 150); // Small delay to bridge gap
      };

      // Hover on Catalog Link
      catalogLink.parentElement.addEventListener('mouseenter', () => {
        cancelHide();
        show();
      });
      catalogLink.parentElement.addEventListener('mouseleave', scheduleHide);

      // Hover on the Nav Bar itself (so it doesn't disappear when using it)
      catNav.addEventListener('mouseenter', () => {
        cancelHide();
        show();
      });
      catNav.addEventListener('mouseleave', scheduleHide);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNav);
    } else {
      initNav();
    }
  })();
</script>

<style>
  /* Premium Racing Category Navigation */
  #category-nav {
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: linear-gradient(180deg, #ffffff 0%, #f8f8f8 100%);
    border-bottom: 1px solid rgba(204, 0, 0, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08), inset 0 -1px 0 rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease-in-out;
  }
  
  /* Start hidden state */
  #category-nav.nav-hidden {
    height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    padding: 0;
    border: none;
  }
  
  /* Visible state */
  #category-nav.nav-visible {
    height: 40px; /* Matched to h-10 from tailwind */
    opacity: 1;
    visibility: visible;
  }
  #category-nav::-webkit-scrollbar {
    display: none;
  }
  
  /* Vehicle Badge - Racing Style */
  #vehicle-badge > span:first-child {
    background: linear-gradient(135deg, rgba(204, 0, 0, 0.15) 0%, rgba(204, 0, 0, 0.08) 100%);
    border: 1px solid rgba(204, 0, 0, 0.4);
    color: #CC0000;
    box-shadow: 0 0 12px rgba(204, 0, 0, 0.15);
    backdrop-filter: blur(10px);
    animation: vehiclePulse 2s ease-in-out infinite;
  }
  @keyframes vehiclePulse {
    0%, 100% { box-shadow: 0 0 12px rgba(204, 0, 0, 0.15); }
    50% { box-shadow: 0 0 20px rgba(204, 0, 0, 0.25); }
  }
  
  #btn-clear-vehicle {
    color: #999;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #btn-clear-vehicle:hover {
    color: #CC0000;
    background: rgba(204, 0, 0, 0.1);
    transform: rotate(90deg);
  }
  
  /* Category Links - Racing Style */
  .category-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #555555;
    white-space: nowrap;
    text-decoration: none;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Animated underline effect */
  .category-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #CC0000, transparent);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
  }
  
  .category-link:hover {
    color: #CC0000;
    background: linear-gradient(180deg, rgba(204, 0, 0, 0.08) 0%, rgba(204, 0, 0, 0.03) 100%);
  }
  .category-link:hover::after {
    width: 80%;
  }
  
  /* Active State - Racing Red */
  .category-link.active {
    color: #CC0000;
    background: linear-gradient(180deg, rgba(204, 0, 0, 0.12) 0%, rgba(204, 0, 0, 0.05) 100%);
    font-weight: 800;
  }
  .category-link.active::after {
    width: 60%;
    background: #CC0000;
    box-shadow: 0 0 8px rgba(204, 0, 0, 0.6);
  }
  
  /* Count Badge */
  .category-link span {
    opacity: 0.5;
    font-size: 9px;
    font-weight: 500;
    transition: opacity 0.3s;
  }
  .category-link:hover span,
  .category-link.active span {
    opacity: 0.7;
  }
  
  /* Loading Animation */
  #category-links span:only-child {
    animation: loadingPulse 1.5s ease-in-out infinite;
  }
  @keyframes loadingPulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
  }
  
  /* Responsive */
  @media (max-width: 1024px) {
    .category-link {
      padding: 6px 12px;
      font-size: 10px;
    }
  }
  
  /* No Parts Slow Pulse Animation */
  .no-parts-pulse {
    animation: noPartsPulse 3s ease-in-out infinite;
  }
  @keyframes noPartsPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* ========================================
     SEARCH DRAWER (HUD command palette)
     ======================================== */
  .search-drawer {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    color: #fff;
    overflow: visible;
  }

  .search-drawer::backdrop {
    background: rgba(5, 5, 5, 0.78);
    backdrop-filter: blur(8px) saturate(140%);
    -webkit-backdrop-filter: blur(8px) saturate(140%);
  }

  .search-drawer[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(12px, 8vh, 96px) 16px 16px;
  }

  .search-drawer__panel {
    position: relative;
    width: 100%;
    max-width: 720px;
    background: linear-gradient(180deg, #0d0d0d 0%, #050505 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(204, 0, 0, 0.06) inset,
      0 0 60px -10px rgba(204, 0, 0, 0.2);
    animation: searchDrawerIn 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  @keyframes searchDrawerIn {
    from { opacity: 0; transform: translateY(-12px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Corner brackets */
  .search-drawer__corner {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }
  .search-drawer__corner--tl { top: -1px; left: -1px; border-top: 1.5px solid #CC0000; border-left: 1.5px solid #CC0000; }
  .search-drawer__corner--tr { top: -1px; right: -1px; border-top: 1.5px solid #CC0000; border-right: 1.5px solid #CC0000; }
  .search-drawer__corner--bl { bottom: -1px; left: -1px; border-bottom: 1.5px solid #CC0000; border-left: 1.5px solid #CC0000; }
  .search-drawer__corner--br { bottom: -1px; right: -1px; border-bottom: 1.5px solid #CC0000; border-right: 1.5px solid #CC0000; }

  /* Header strip */
  .search-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
  }

  .search-drawer__header-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .search-drawer__indicator {
    width: 7px;
    height: 7px;
    background: #CC0000;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(204, 0, 0, 0.7);
    animation: pulse 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }

  .search-drawer__heading {
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .search-drawer__heading-meta {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .search-drawer__heading-meta { display: none; }
  }

  .search-drawer__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.6);
    padding: 5px 10px;
    cursor: pointer;
    transition: all 160ms ease;
    font-family: inherit;
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .search-drawer__close:hover {
    color: #fff;
    border-color: #CC0000;
    background: rgba(204, 0, 0, 0.12);
  }

  .search-drawer__close-kbd {
    font-family: inherit;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.1em;
  }
  .search-drawer__close:hover .search-drawer__close-kbd { color: #fff; }

  /* Predictive-search wrapper just collapses to its children — keep layout clean. */
  .search-drawer__predictive {
    display: block;
  }
  .search-drawer__form {
    display: block;
  }

  /* Input row */
  .search-drawer__input-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 200ms ease;
  }
  .search-drawer__input-row:focus-within {
    border-bottom-color: rgba(204, 0, 0, 0.6);
  }

  .search-drawer__lens {
    width: 18px;
    height: 18px;
    color: #CC0000;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .search-drawer__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: inherit;
    font-size: 17px;
    letter-spacing: 0.01em;
    padding: 4px 0;
    min-width: 0;
  }
  .search-drawer__input::placeholder {
    color: rgba(255, 255, 255, 0.28);
    font-weight: 400;
  }
  .search-drawer__input::-webkit-search-cancel-button { display: none; }

  .search-drawer__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: all 160ms ease;
  }
  .search-drawer__clear:hover {
    color: #fff;
    background: rgba(204, 0, 0, 0.18);
    border-color: rgba(204, 0, 0, 0.5);
  }

  /* Suggestion chips */
  .search-drawer__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .search-drawer__chips[hidden] { display: none; }

  .search-drawer__chip-label {
    font-size: 9px;
    color: #CC0000;
    letter-spacing: 0.18em;
    margin-right: 4px;
    font-weight: 600;
  }

  .search-drawer__chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.78);
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 5px 11px;
    cursor: pointer;
    transition: all 160ms ease;
  }
  .search-drawer__chip:hover {
    color: #fff;
    background: rgba(204, 0, 0, 0.12);
    border-color: rgba(204, 0, 0, 0.5);
    transform: translateY(-1px);
  }

  /* Predictive results container — Shopify renders into this. */
  .search-drawer__results {
    max-height: min(60vh, 540px);
    overflow-y: auto;
    background: rgba(255, 255, 255, 0.01);
  }
  .search-drawer__results:empty {
    display: none;
  }
  .search-drawer__results::-webkit-scrollbar { width: 8px; }
  .search-drawer__results::-webkit-scrollbar-track { background: transparent; }
  .search-drawer__results::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
  }
  .search-drawer__results::-webkit-scrollbar-thumb:hover {
    background: rgba(204, 0, 0, 0.4);
  }

  /* Soft-style overrides so Shopify's predictive-search markup blends in */
  .search-drawer__results a,
  .search-drawer__results [role="option"] {
    color: rgba(255, 255, 255, 0.85);
  }
  .search-drawer__results a:hover,
  .search-drawer__results [role="option"]:hover,
  .search-drawer__results [aria-selected="true"] {
    background: rgba(204, 0, 0, 0.08);
    color: #fff;
  }

  /* Status line */
  .search-drawer__status {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.4);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .search-drawer__status-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.6);
  }
  .search-drawer__status-text { color: rgba(255, 255, 255, 0.7); }
  .search-drawer__status-spacer { flex: 1; }
  .search-drawer__status-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.45);
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .search-drawer__status-hint kbd {
    font-family: inherit;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 540px) {
    .search-drawer__input { font-size: 16px; } /* avoid iOS zoom */
    .search-drawer__chips { padding: 12px 16px; }
    .search-drawer__input-row { padding: 14px 16px; }
    .search-drawer__status-hint { display: none; }
  }
</style>

<!-- Mobile Menu Drawer -->
<dialog id="mobile-menu-drawer" class="fixed inset-y-0 left-0 z-[3000] w-[85vw] max-w-[400px] h-[100dvh] max-h-[100dvh] bg-white p-0 m-0 border-r border-gray-100 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm open:animate-slide-in-left outline-none">
  <div class="flex flex-col h-full bg-white">
    <!-- Header -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-white">
      <span class="text-xl font-bold uppercase tracking-tighter">{{ shop.name }}</span>
      <button onclick="document.getElementById('mobile-menu-drawer').close()" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-gray-500 group-hover:text-[#CC0000]">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto overflow-x-hidden p-0 bg-white">
      <nav class="py-4">
        <ul class="flex flex-col">
          {%- for link in section.settings.menu.links -%}
            <li class="border-b border-gray-50 last:border-none">
              {%- if link.links != blank -%}
                <details class="group/dropdown">
                  <summary class="flex items-center justify-between w-full px-8 py-5 text-left cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <span class="text-lg font-bold text-[#111111] uppercase tracking-wide group-hover/dropdown:text-[#CC0000] transition-colors">{{ link.title }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400 group-open/dropdown:rotate-180 transition-transform duration-300">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </summary>
                  <div class="bg-gray-50 px-8 py-4 space-y-4">
                    {%- for child_link in link.links -%}
                      <div>
                        <a href="{{ child_link.url }}" class="block text-sm font-bold text-[#111111] uppercase tracking-wider mb-2">{{ child_link.title }}</a>
                        {%- if child_link.links != blank -%}
                          <ul class="pl-4 space-y-2 border-l border-gray-200">
                            {%- for grandchild_link in child_link.links -%}
                              <li>
                                <a href="{{ grandchild_link.url }}" class="block text-sm text-gray-500 hover:text-[#CC0000]">{{ grandchild_link.title }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="block w-full px-8 py-5 text-lg font-bold text-[#111111] uppercase tracking-wide hover:text-[#CC0000] hover:bg-gray-50 transition-colors">
                  {{ link.title }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <!-- Footer Actions -->
    <div class="p-6 border-t border-gray-100 bg-white space-y-4">
      {% if request.design_mode %}
        <button type="button" class="flex items-center justify-center w-full h-14 bg-[#111111] text-white font-bold uppercase tracking-widest hover:bg-[#CC0000] transition-colors shadow-lg">
          {% if customer %}My Garage{% else %}Login disabled{% endif %}
        </button>
      {% else %}
        {% if customer %}
          <a href="/account" class="flex items-center justify-center w-full h-14 bg-[#111111] text-white font-bold uppercase tracking-widest hover:bg-[#CC0000] transition-colors shadow-lg mb-3">
            My Garage
          </a>
          <a href="{{ routes.account_logout_url }}?return_url={{ routes.account_login_url | append: '?logged_out=true' | url_encode }}" class="flex items-center justify-center w-full h-12 border border-gray-200 text-gray-500 font-bold uppercase tracking-widest hover:text-[#111111] hover:border-[#111111] transition-colors">
            Sign Out
          </a>
        {% else %}
          <a href="/account/login" class="flex items-center justify-center w-full h-14 bg-[#CC0000] text-white font-bold uppercase tracking-widest hover:bg-red-700 transition-colors shadow-lg">
            Login / Register
          </a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</dialog>

<!-- Search Drawer (HUD-styled command palette) -->
<dialog id="search-drawer" class="search-drawer" aria-label="Search">
  <div class="search-drawer__panel">
    <!-- Corner brackets — match VEHICLE IDENTIFICATION SYSTEM modal -->
    <span class="search-drawer__corner search-drawer__corner--tl" aria-hidden="true"></span>
    <span class="search-drawer__corner search-drawer__corner--tr" aria-hidden="true"></span>
    <span class="search-drawer__corner search-drawer__corner--bl" aria-hidden="true"></span>
    <span class="search-drawer__corner search-drawer__corner--br" aria-hidden="true"></span>

    <!-- Header strip -->
    <div class="search-drawer__header">
      <div class="search-drawer__header-left">
        <span class="search-drawer__indicator" aria-hidden="true"></span>
        <span class="search-drawer__heading">SEARCH SYSTEM</span>
        <span class="search-drawer__heading-meta">// COMPONENT LOOKUP</span>
      </div>
      <button type="button" class="search-drawer__close" onclick="document.getElementById('search-drawer').close()" aria-label="Close search">
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="search-drawer__close-kbd">ESC</span>
      </button>
    </div>

    <!-- Input row -->
    <predictive-search class="search-drawer__predictive">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
        <div class="search-drawer__input-row">
          <svg class="search-drawer__lens" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35"></path>
          </svg>
          <input
            id="Search-In-Modal"
            type="search"
            name="q"
            value=""
            placeholder="Search parts, vehicles, or part numbers..."
            class="search-drawer__input"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
          >
          <button type="reset" class="search-drawer__clear" aria-label="Clear search" hidden>
            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <input name="options[prefix]" type="hidden" value="last">

        <!-- Suggestion chips (visible until the user types) -->
        <div class="search-drawer__chips" data-search-suggestions>
          <span class="search-drawer__chip-label">TRY</span>
          <button type="button" class="search-drawer__chip" data-suggest="exhaust">Exhaust</button>
          <button type="button" class="search-drawer__chip" data-suggest="intake">Intake</button>
          <button type="button" class="search-drawer__chip" data-suggest="brake kit">Brake kit</button>
          <button type="button" class="search-drawer__chip" data-suggest="suspension">Suspension</button>
          <button type="button" class="search-drawer__chip" data-suggest="turbo">Turbo</button>
        </div>

        <!-- Predictive results land here -->
        <div id="predictive-search" tabindex="-1" class="search-drawer__results"></div>

        <!-- Status line -->
        <div class="search-drawer__status">
          <span class="search-drawer__status-dot"></span>
          <span class="search-drawer__status-text">READY</span>
          <span class="search-drawer__status-spacer"></span>
          <span class="search-drawer__status-hint"><kbd>↵</kbd> to view all results</span>
        </div>
      </form>
    </predictive-search>
  </div>
</dialog>

<script>
  (function () {
    const dialog = document.getElementById('search-drawer');
    if (!dialog) return;
    const input = dialog.querySelector('#Search-In-Modal');
    const clearBtn = dialog.querySelector('.search-drawer__clear');
    const chipsContainer = dialog.querySelector('[data-search-suggestions]');
    const statusText = dialog.querySelector('.search-drawer__status-text');

    const setEmptyState = (isEmpty) => {
      if (chipsContainer) chipsContainer.hidden = !isEmpty;
      if (clearBtn) clearBtn.hidden = isEmpty;
      if (statusText) statusText.textContent = isEmpty ? 'READY' : 'SEARCHING';
    };

    // <dialog> has no "open" event, so observe the open attribute.
    new MutationObserver(() => {
      if (!dialog.open) return;
      if (input) {
        requestAnimationFrame(() => {
          input.focus();
          input.select();
        });
        setEmptyState(!input.value);
      }
    }).observe(dialog, { attributes: true, attributeFilter: ['open'] });

    // Track input state to swap chips/clear button.
    if (input) {
      input.addEventListener('input', () => setEmptyState(!input.value));
    }

    // Reset state when the dialog closes (so re-opening shows chips again).
    dialog.addEventListener('close', () => {
      if (input && !input.value) setEmptyState(true);
    });

    // Clear button resets and refocuses.
    if (clearBtn && input) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      });
    }

    // Suggestion chips populate the input and trigger predictive search.
    if (chipsContainer && input) {
      chipsContainer.addEventListener('click', (e) => {
        const target = e.target.closest('[data-suggest]');
        if (!target) return;
        e.preventDefault();
        input.value = target.dataset.suggest;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      });
    }

    // Set initial empty state on first paint.
    setEmptyState(true);
  })();
</script>

