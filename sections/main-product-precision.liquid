        color: #111;
        cursor: pointer;
        outline: none;
        transition: all 0.2s ease;
        text-transform: uppercase;
        width: 100%;
        background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23111111' stroke-width='1.5' stroke-linecap='square'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 14px center;
      }
      .tcc-select:focus {
        border-color: #111;
