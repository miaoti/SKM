      }
      .tcc-check-btn:active {
        background-color: #990000;
      }
      
      /* Existing Styles... */
      .tcc-make-header {
          font-family: 'Inter', sans-serif;
          font-size: 14px;
          font-weight: 700;
          color: #111;
          margin-bottom: 16px;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          border-bottom: 1px solid #eee;
          padding-bottom: 8px;
        }
        
        .tcc-model-header {
          font-family: 'Inter', sans-serif;
          font-size: 12px; 
          font-weight: 600;
          color: #444;
          margin-bottom: 8px;
          text-transform: uppercase;
          letter-spacing: 0.05em;
        }
        
        .tcc-vehicle-list {
          list-style: none;
          padding: 0;
          margin: 0;
          display: flex;
          flex-wrap: wrap;
          gap: 8px 16px;
        }
        
