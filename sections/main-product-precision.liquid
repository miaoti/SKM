        }
      </style>
    {%- endif -%}

    <!-- Dynamic Product Sections -->
    {%- if product.metafields.custom.product_sections.value != blank -%}
      <div class="tcc-dynamic-sections mt-6 border-t border-[var(--tcc-border)]">
        {%- assign sections_data = product.metafields.custom.product_sections.value -%}
        {%- for section_item in sections_data -%}
          <div class="tcc-dynamic-section border-b border-[var(--tcc-border)] last:border-0">
            
            <!-- Accordion Header -->
            <button 
              type="button" 
              class="tcc-section-toggle w-full flex items-baseline justify-between group cursor-pointer focus:outline-none py-4"
              aria-expanded="false"
              aria-controls="dynamic-section-{{ forloop.index }}"
            >
              <div class="tcc-tech-brief-header mb-0 select-none text-[#111] group-hover:text-[#CC0000] transition-colors">
                [ {{ section_item.name | default: 'DETAILS' }} ]
              </div>
              
              <div class="tcc-toggle-icon transform transition-transform duration-300 relative top-[2px]">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                </svg>
              </div>
            </button>

            <!-- Accordion Content -->
            <div id="dynamic-section-{{ forloop.index }}" class="hidden overflow-hidden transition-all duration-300 pb-8">
              {%- comment -%} Check for new mixed-content structure vs legacy {%- endcomment -%}
              {%- if section_item.blocks -%}
                {%- comment -%} New structure with blocks array {%- endcomment -%}
                {%- assign layout = section_item.layout | default: 'stacked' -%}
                
                {%- if layout == 'stacked' -%}
                  {%- comment -%} Stacked: Full width, blocks in order {%- endcomment -%}
                  <div class="tcc-section-stacked space-y-6">
                    {%- for block in section_item.blocks -%}
                      {%- if block.type == 'text' -%}
                        <div class="tcc-content-text font-sans text-sm leading-relaxed text-[#333] whitespace-pre-line">
                          {{ block.content }}
                        </div>
                      {%- elsif block.type == 'media' or block.type == 'image' -%}
                        {%- if block.url != blank -%}
                          {%- if block.mimeType contains 'video' or block.mimeType contains 'VIDEO' or block.url contains '.mp4' or block.url contains '.webm' or block.url contains '.mov' -%}
                            <div class="tcc-content-video aspect-w-16 aspect-h-9 bg-black overflow-hidden rounded-lg">
                              <video src="{{ block.url }}" controls class="w-full h-full object-cover">
                                Your browser does not support the video tag.
                              </video>
                            </div>
                          {%- else -%}
                            <div class="tcc-content-image">
                              <img src="{{ block.url }}" alt="Product detail" class="w-full h-auto border border-[var(--tcc-border)] rounded-lg" loading="lazy">
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  
                {%- elsif layout == 'media_left' or layout == 'media_right' -%}
                  {%- comment -%} Side-by-side layout {%- endcomment -%}
                  {%- assign text_blocks = '' -%}
                  {%- assign media_block = nil -%}
                  {%- for block in section_item.blocks -%}
                    {%- if block.type == 'text' -%}
                      {%- capture text_blocks -%}{{ text_blocks }}<div class="tcc-content-text font-sans text-sm leading-relaxed text-[#333] whitespace-pre-line mb-4">{{ block.content }}</div>{%- endcapture -%}
                    {%- elsif block.type == 'media' or block.type == 'image' -%}
                      {%- if media_block == nil and block.url != blank -%}
                        {%- assign media_block = block -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  
                  <div class="tcc-section-split grid md:grid-cols-2 gap-8 items-start">
                    {%- if layout == 'media_left' -%}
                      <div class="tcc-media-column">
                        {%- if media_block -%}
                          {%- if media_block.mimeType contains 'video' or media_block.mimeType contains 'VIDEO' or media_block.url contains '.mp4' or media_block.url contains '.webm' -%}
                            <div class="aspect-w-16 aspect-h-9 bg-black overflow-hidden rounded-lg">
                              <video src="{{ media_block.url }}" controls class="w-full h-full object-cover"></video>
                            </div>
                          {%- else -%}
                            <img src="{{ media_block.url }}" alt="Product detail" class="w-full h-auto border border-[var(--tcc-border)] rounded-lg" loading="lazy">
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                      <div class="tcc-text-column">{{ text_blocks }}</div>
                    {%- else -%}
                      <div class="tcc-text-column">{{ text_blocks }}</div>
                      <div class="tcc-media-column">
                        {%- if media_block -%}
                          {%- if media_block.mimeType contains 'video' or media_block.mimeType contains 'VIDEO' or media_block.url contains '.mp4' or media_block.url contains '.webm' -%}
                            <div class="aspect-w-16 aspect-h-9 bg-black overflow-hidden rounded-lg">
                              <video src="{{ media_block.url }}" controls class="w-full h-full object-cover"></video>
                            </div>
                          {%- else -%}
                            <img src="{{ media_block.url }}" alt="Product detail" class="w-full h-auto border border-[var(--tcc-border)] rounded-lg" loading="lazy">
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                
              {%- else -%}
                {%- comment -%} Legacy structure fallback {%- endcomment -%}
                {%- case section_item.type -%}
                  {%- when 'text' -%}
                    <div class="tcc-content-text font-sans text-sm leading-relaxed text-[#333] whitespace-pre-line">
                      {{ section_item.content }}
                    </div>
                  {%- when 'image' -%}
                    {%- if section_item.url != blank -%}
                      <div class="tcc-content-image my-6">
                        <img src="{{ section_item.url }}" alt="Product detail" class="w-full h-auto border border-[var(--tcc-border)]" loading="lazy">
                      </div>
                    {%- endif -%}
                  {%- when 'video' -%}
                    {%- if section_item.url != blank -%}
                      <div class="tcc-content-video my-6 aspect-w-16 aspect-h-9 bg-black overflow-hidden">
                        <video src="{{ section_item.url }}" controls class="w-full h-full object-cover">
                          Your browser does not support the video tag.
                        </video>
                      </div>
                    {%- endif -%}
                {%- endcase -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
  </div>
</div>

<!-- Gallery Interaction + Variant Filter + Toggle Script -->
<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    // --- 1. Accordion Toggles (Fitment & Dynamic Sections) ---
    function setupToggle(btn) {
      if (!btn) return;
      btn.addEventListener('click', function() {
        const contentId = btn.getAttribute('aria-controls');
        const contentDiv = document.getElementById(contentId);
        const icon = btn.querySelector('.tcc-toggle-icon');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        
        if (!isExpanded) {
          if(contentDiv) contentDiv.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if(icon) icon.style.transform = 'rotate(180deg)';
        } else {
          if(contentDiv) contentDiv.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if(icon) icon.style.transform = 'rotate(0deg)';
        }
      });
    }

    // Fitment Toggle
    const fitmentToggle = document.querySelector('.tcc-fitment-toggle');
    if (fitmentToggle) setupToggle(fitmentToggle);

    // Dynamic Section Toggles
    document.querySelectorAll('.tcc-section-toggle').forEach(setupToggle);


    // --- 2. Existing Gallery & Variant Logic ---
    const thumbnails = document.querySelectorAll('[data-thumbnail-btn]');
    const slides = document.querySelectorAll('[data-media-slide]');
    
    // Click handler for thumbnails
    function activateThumbnail(thumb) {
      const index = thumb.dataset.mediaIndex;
      
      // Update thumbnail active state
      thumbnails.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
      
      // Cross-fade slides
      slides.forEach(function(slide) {
        if (slide.dataset.mediaIndex === index) {
          slide.classList.remove('media-hidden');
        } else {
          slide.classList.add('media-hidden');
        }
      });
    }
    
    thumbnails.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        activateThumbnail(this);
      });
    });
    
    // Variant media filtering
    function filterMediaByVariant() {
      // Get selected option values (check Material option specifically for this product)
      const selectedValues = [];
      
      document.querySelectorAll('fieldset.variant-option-group').forEach(function(fieldset) {
        const checkedInput = fieldset.querySelector('input[type="radio"]:checked');
        if (checkedInput && checkedInput.value) {
          selectedValues.push(checkedInput.value.toLowerCase().trim());
        }
      });
      
      if (selectedValues.length === 0) {
        // No variant selected, show all
        thumbnails.forEach(t => t.style.display = '');
        slides.forEach(s => s.style.display = '');
        return;
      }
      
      let hasMatchingMedia = false;
      let firstMatchingThumb = null;
      
      thumbnails.forEach(function(thumb, idx) {
        const alt = (thumb.dataset.mediaAlt || '').toLowerCase().trim();
        const slide = slides[idx];
        
        // Check if media alt contains any selected option value
        let matches = false;
        
        if (alt === '') {
          // Untagged media - show it
          matches = true;
        } else {
          // Check if alt text matches any selected variant
          matches = selectedValues.some(val => alt.includes(val));
        }
        
        if (matches) {
          thumb.style.display = '';
          if (slide) slide.style.display = '';
          hasMatchingMedia = true;
          if (!firstMatchingThumb) firstMatchingThumb = thumb;
        } else {
          thumb.style.display = 'none';
          if (slide) slide.style.display = 'none';
        }
      });
      
      // If no matching media found, show all
      if (!hasMatchingMedia) {
        thumbnails.forEach(t => t.style.display = '');
        slides.forEach(s => s.style.display = '');
        firstMatchingThumb = thumbnails[0];
      }
      
      // Activate first matching thumbnail
      if (firstMatchingThumb && !firstMatchingThumb.classList.contains('active')) {
        activateThumbnail(firstMatchingThumb);
      }
    }
    
    // Listen for variant changes (per-radio is enough; bubbling to a form-level
    // delegate would fire filterMediaByVariant a second time per click).
    document.querySelectorAll('input[type="radio"][name*="option"]').forEach(input => {
      input.addEventListener('change', filterMediaByVariant);
    });

    // Initial filter
    filterMediaByVariant();
  });
})();
</script>

