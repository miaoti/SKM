{% comment %}
  Main Product Precision - "Technical Command Center" Design
  Porsche-inspired clean, authoritative, precise aesthetic
{% endcomment %}

<script>
  // Expose compatible vehicles to JS
  window.productCompatibleVehicles = [
    {%- if product.metafields.custom.fits_vehicles.value != blank -%}
      {%- for vehicle in product.metafields.custom.fits_vehicles.value -%}
        "{{ vehicle.system.id }}",
      {%- endfor -%}
    {%- endif -%}
  ];
</script>

{% comment %} Product JSON for variant media filter {% endcomment %}
<script type="application/json" data-product-json>
  {{ product | json }}
</script>

{% comment %} Technical Command Center Styles {% endcomment %}
<style>
  .tcc-page {
    --tcc-obsidian: #111111;
    --tcc-white: #FFFFFF;
    --tcc-red: #CC0000;
    --tcc-border: #E5E5E5;
    --tcc-grey-light: #F8F8F8;
    --tcc-grey-text: #666666;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  
  /* Thumbnail Gallery */
  .tcc-gallery {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    height: fit-content;
  }
  
  .tcc-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 600px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  
  .tcc-thumbnail {
    width: 80px;
    height: 80px;
    border: 0.5px solid var(--tcc-border);
    cursor: pointer;
    opacity: 0.6;
    transition: all 0.3s ease;
    overflow: hidden;
    flex-shrink: 0;
  }
  
  .tcc-thumbnail:hover,
  .tcc-thumbnail.active {
    opacity: 1;
    border-color: var(--tcc-obsidian);
  }
  
  .tcc-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .tcc-main-image {
    position: relative;
    border: 1px solid var(--tcc-border);
    background: var(--tcc-white);
    overflow: hidden;
  }
  
  .tcc-main-image img,
  .tcc-main-image .product-media {
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: opacity 0.4s ease;
  }
  
  .tcc-main-image .media-hidden {
    opacity: 0;
    position: absolute;
    pointer-events: none;
  }
  
  /* Glassmorphism Control Panel */
  .tcc-control-panel {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 0.5px solid var(--tcc-border);
    padding: 32px;
  }
  
  /* Typography */
  .tcc-title {
    font-family: 'Helvetica Neue', 'Arial', sans-serif;
    font-size: 32px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--tcc-obsidian);
    margin: 0 0 8px 0;
    line-height: 1.1;
  }
  
  .tcc-spec-id {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 12px;
    color: var(--tcc-grey-text);
    margin-bottom: 24px;
  }
  
  /* Pricing Module */
  .tcc-pricing {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  
  .tcc-price-main {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 28px;
    font-weight: 700;
    color: var(--tcc-obsidian);
  }
  
  .tcc-price-crossed {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 16px;
    color: var(--tcc-grey-text);
    text-decoration: line-through;
  }
  
  .tcc-badge-wholesale {
    display: inline-block;
    border: 1px solid var(--tcc-red);
    color: var(--tcc-red);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    letter-spacing: 0.1em;
  }
  
  /* Availability */
  .tcc-availability {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
    color: var(--tcc-grey-text);
    margin-bottom: 24px;
    padding: 12px 0;
    border-top: 0.5px solid var(--tcc-border);
    border-bottom: 0.5px solid var(--tcc-border);
  }
  
  .tcc-availability .in-stock {
    color: #16a34a;
    font-weight: 600;
  }
  
  .tcc-availability .out-of-stock {
    color: var(--tcc-red);
    font-weight: 600;
  }
  
  /* Technical Brief Section (Full Width) */
  .tcc-tech-brief-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 0.5px solid var(--tcc-border);
  }
  
  .tcc-tech-brief-header {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
    color: var(--tcc-red);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
  }
  
  .tcc-tech-brief-content {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #333;
    white-space: pre-line;
  }
  
  .tcc-tech-brief-content p {
    margin-bottom: 16px;
  }
  
  .tcc-tech-brief-content ul,
  .tcc-tech-brief-content ol {
    margin-left: 20px;
    margin-bottom: 16px;
  }
  
  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .tcc-gallery {
      grid-template-columns: 1fr;
    }
    
    .tcc-thumbnails {
      flex-direction: row;
      max-height: none;
      overflow-x: auto;
      order: 2;
    }
    
    .tcc-main-image {
      order: 1;
    }
    
    .tcc-control-panel {
      position: relative !important;
      top: auto !important;
    }
  }
</style>

<div class="tcc-page bg-white text-black">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-0">
    <div class="grid grid-cols-1 lg:grid-cols-[60%_40%] gap-8 lg:gap-12">
      
      <!-- LEFT: MEDIA GALLERY (60%) -->
      <div class="tcc-gallery" data-product-media-container>
        <!-- Thumbnail Rail -->
        <div class="tcc-thumbnails">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button 
                class="tcc-thumbnail {% if forloop.first %}active{% endif %}" 
                data-thumbnail-btn
                data-media-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-alt="{{ media.alt | escape | downcase }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img 
                  src="{{ media.preview_image | image_url: width: 160 }}" 
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
        
        <!-- Main Viewport -->
        <div class="tcc-main-image">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div 
                class="tcc-media-slide {% unless forloop.first %}media-hidden{% endunless %}" 
                data-media-slide 
                data-media-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-alt="{{ media.alt | escape | downcase }}"
              >
                {% render 'product-media', 
                  media: media, 
                  loop: section.settings.enable_video_looping, 
                  variant_image: false,
                  loading: forloop.first | ternary: 'eager', 'lazy',
                  widths: '550, 750, 1100, 1500, 2000'
                %}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="flex items-center justify-center h-full text-gray-400">
              {{ 'product-1' | placeholder_svg_tag: 'w-1/3 h-1/3' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT: CONTROL PANEL (40%) -->
      <div class="tcc-control-panel lg:sticky lg:top-8 h-fit">
        
        <!-- Header: Title + SPEC_ID -->
        <h1 class="tcc-title">{{ product.title }}</h1>
        <div class="tcc-spec-id" id="product-sku-display">
          {%- if product.selected_or_first_available_variant.sku != blank -%}
            [ SPEC_ID: <span class="text-black font-semibold">{{ product.selected_or_first_available_variant.sku }}</span> ]
          {%- else -%}
            [ SPEC_ID: {{ product.id }} ]
          {%- endif -%}
        </div>

        <!-- Pricing Module (Logic Preserved) -->
        {%- liquid
          assign selected_variant = product.selected_or_first_available_variant
          assign original_price = selected_variant.price
          assign compare_at_price = selected_variant.compare_at_price
          
          assign variant_b2b_price_raw = selected_variant.metafields.custom.b2b_price.value
          assign product_b2b_price_raw = product.metafields.custom.b2b_price.value
          assign variant_discount_price_raw = selected_variant.metafields.custom.discount_price.value
          assign product_discount_price_raw = product.metafields.custom.discount_price.value
          
          assign b2b_price_raw = variant_b2b_price_raw
          if b2b_price_raw == blank or b2b_price_raw == empty
            assign b2b_price_raw = product_b2b_price_raw
          endif
          
          assign discount_price_raw = variant_discount_price_raw
          if discount_price_raw == blank or discount_price_raw == empty
            assign discount_price_raw = product_discount_price_raw
          endif
          
          assign b2b_price = nil
          assign discount_price = nil
          
          if b2b_price_raw != blank and b2b_price_raw != empty
            assign b2b_price = b2b_price_raw | times: 100
          endif
          
          if discount_price_raw != blank and discount_price_raw != empty
            assign discount_price = discount_price_raw | times: 100
          endif
          
          assign is_b2b_user = false
          if customer
            for tag in customer.tags
              assign tag_downcase = tag | downcase | strip
              if tag_downcase == 'b2b' or tag_downcase == 'wholesale' or tag_downcase == 'business'
                assign is_b2b_user = true
                break
              endif
            endfor
          endif
          
          assign display_price = original_price
          assign crossed_out_price = nil
          assign price_badge = nil
          assign is_wholesale = false
          assign percent_off = 0
          assign show_crossed_price = false
          
          if is_b2b_user
            if discount_price != nil and b2b_price != nil
              if b2b_price <= discount_price
                assign display_price = b2b_price
                assign crossed_out_price = original_price
                assign price_badge = 'WHOLESALE'
                assign is_wholesale = true
              else
                assign display_price = discount_price
                assign crossed_out_price = original_price
                assign price_diff = original_price | minus: discount_price
                assign percent_off = price_diff | times: 100 | divided_by: original_price | round
              endif
              assign show_crossed_price = true
            elsif b2b_price != nil
              assign display_price = b2b_price
              assign crossed_out_price = original_price
              assign price_badge = 'WHOLESALE'
              assign is_wholesale = true
              assign show_crossed_price = true
            elsif discount_price != nil
              assign display_price = discount_price
              assign crossed_out_price = original_price
              assign price_diff = original_price | minus: discount_price
              assign percent_off = price_diff | times: 100 | divided_by: original_price | round
              assign show_crossed_price = true
            endif
          else
            if discount_price != nil
              assign display_price = discount_price
              assign crossed_out_price = original_price
              assign price_diff = original_price | minus: discount_price
              assign percent_off = price_diff | times: 100 | divided_by: original_price | round
              assign show_crossed_price = true
            elsif compare_at_price > original_price
              assign crossed_out_price = compare_at_price
              assign price_diff = compare_at_price | minus: original_price
              assign percent_off = price_diff | times: 100 | divided_by: compare_at_price | round
              assign show_crossed_price = true
            endif
          endif
        -%}
        
        <div class="tcc-pricing" id="product-price-display">
          {%- if show_crossed_price and crossed_out_price -%}
            <span class="tcc-price-crossed" data-compare-price>{{ crossed_out_price | money }}</span>
          {%- endif -%}
          <span class="tcc-price-main" data-product-price>{{ display_price | money }}</span>
          {%- if is_wholesale -%}
            <span class="tcc-badge-wholesale">WHOLESALE</span>
          {%- endif -%}
        </div>

        <!-- Availability -->
        <div class="tcc-availability" id="product-availability-display">
          STATUS: 
          {%- if product.selected_or_first_available_variant.available -%}
            <span class="in-stock">IN_STOCK</span> // QTY: <span id="product-inventory-count">{{ product.selected_or_first_available_variant.inventory_quantity | default: '1+' }}</span>
          {%- else -%}
            <span class="out-of-stock">OUT_OF_STOCK</span>
          {%- endif -%}
        </div>
        
        <!-- Buy Buttons -->
        {%- render 'buy-buttons-precision', product: product, product_form_id: 'product-form-' | append: section.id -%}

      </div>
    </div>
    
    <!-- Technical Brief Section (Full Width) -->
    {%- if product.description != blank -%}
      <div class="tcc-tech-brief-section">
        <div class="tcc-tech-brief-header">[ TECHNICAL_BRIEF ]</div>
        <div class="tcc-tech-brief-content">
          {{ product.description }}
        </div>
      </div>
    {%- endif -%}

    <!-- VEHICLE FITMENT SECTION (Relocated) -->
    {%- if product.metafields.custom.fits_vehicles.value != blank -%}
      <div class="tcc-fitment-wrapper border-t border-[var(--tcc-border)] pt-4 mt-6">
        
        <!-- Interactive Header -->
        <button 
          type="button" 
          class="tcc-fitment-toggle w-full flex items-baseline justify-between group cursor-pointer focus:outline-none"
          aria-expanded="false"
          aria-controls="tcc-fitment-content"
        >
          <div class="flex items-baseline gap-4 flex-wrap">
            <div class="tcc-tech-brief-header mb-0 select-none text-[#CC0000]">[ VEHICLE_FITMENT ]</div>
            
            <!-- Integrated Status Status -->
            <div id="tcc-fitment-status-indicator" class="hidden tcc-status-text font-mono text-[11px] tracking-wider uppercase"></div>
          </div>
          
          <div class="tcc-toggle-icon transform transition-transform duration-300 relative top-[2px]">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </div>
        </button>
  
        <!-- Expandable Fitment List -->
      <div id="tcc-fitment-content" class="hidden overflow-hidden transition-all duration-300">
        
        <!-- Manual Checker UI -->
        <div class="tcc-manual-check-wrapper pt-6 pb-2 px-1 mb-6">
          <div class="tcc-tech-brief-header mb-3" style="color: black !important;">[ MANUAL_CHECK ]</div>
          <div id="tcc-manual-grid" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="relative">
              <select id="tcc-manual-year" class="tcc-select w-full">
                <option value="">YEAR</option>
              </select>
            </div>
            <div class="relative">
              <select id="tcc-manual-make" class="tcc-select w-full" disabled>
                <option value="">MAKE</option>
              </select>
            </div>
            <div class="relative">
              <select id="tcc-manual-model" class="tcc-select w-full" disabled>
                <option value="">MODEL</option>
              </select>
            </div>
            <div id="tcc-manual-submodel-wrapper" class="relative hidden">
              <select id="tcc-manual-submodel" class="tcc-select w-full" disabled>
                <option value="">SUBMODEL</option>
              </select>
            </div>
            <button id="tcc-manual-submit" type="button" class="tcc-check-btn w-full">
              VERIFY_FIT
            </button>
          </div>
        </div>

        <div class="tcc-fitment-inner pb-4">
          {%- comment -%} Group by Make logic {%- endcomment -%}
          {%- assign makes_string = '' -%}
          {%- for vehicle in product.metafields.custom.fits_vehicles.value -%}
            {%- assign make_clean = vehicle.make | strip -%}
            {%- unless makes_string contains make_clean -%}
              {%- assign makes_string = makes_string | append: make_clean | append: '|||' -%}
            {%- endunless -%}
          {%- endfor -%}
          {%- assign unique_makes = makes_string | split: '|||' -%}
    
          {%- for make in unique_makes -%}
            {%- if make != blank -%}
              <div class="tcc-make-section mb-10 pl-2">
                <h3 class="tcc-make-header">{{ make }}</h3>
                
                {%- comment -%} Group by Model logic within Make {%- endcomment -%}
                {%- assign models_string = '' -%}
                {%- for vehicle in product.metafields.custom.fits_vehicles.value -%}
                  {%- if vehicle.make == make -%}
                    {%- assign model_clean = vehicle.model | strip -%}
                    {%- unless models_string contains model_clean -%}
                      {%- assign models_string = models_string | append: model_clean | append: '|||' -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign unique_models = models_string | split: '|||' -%}
    
                {%- for model in unique_models -%}
                  {%- if model != blank -%}
                    <div class="tcc-model-group mb-8 pl-6 border-l border-gray-100 ml-1">
                      <h4 class="tcc-model-header">{{ model }}</h4>
                      <ul class="tcc-vehicle-list">
                        {%- comment -%} Sort vehicles by Year {%- endcomment -%}
                        {%- assign sortable_list = '' -%}
                        {%- for vehicle in product.metafields.custom.fits_vehicles.value -%}
                          {%- if vehicle.make == make and vehicle.model == model -%}
                            {%- comment -%} Create sortable string: Year|||Submodel {%- endcomment -%}
                            {%- assign sub = vehicle['submodel'] | default: '' -%}
                            {%- assign entry = vehicle.year | append: '|||' | append: sub -%}
                            {%- assign sortable_list = sortable_list | append: entry | append: '####' -%}
                          {%- endif -%}
                        {%- endfor -%}
                        
                        {%- assign sorted_vehicles = sortable_list | split: '####' | sort -%}
                        
                        {%- for item in sorted_vehicles -%}
                          {%- if item != blank -%}
                            {%- assign parts = item | split: '|||' -%}
                            {%- assign v_year = parts[0] -%}
                            {%- assign v_submodel = parts[1] -%}
                            
                            <li class="tcc-vehicle-item">
                              {%- if v_submodel != blank -%}
                                {{ v_year }} {{ model }} {{ v_submodel }}
                              {%- else -%}
                                {{ v_year }} {{ model }}
                              {%- endif -%}
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // --- Shared Helpers ---
        const normalize = (str) => (str || '').toString().trim().toUpperCase();
        
        // Product's Compatible Keys
        const compatibleKeys = [
          {%- for vehicle in product.metafields.custom.fits_vehicles.value -%}
            "{{ vehicle.year | strip }}::{{ vehicle.make | strip | upcase }}::{{ vehicle.model | strip | upcase }}::{{ vehicle['submodel'] | default: '' | strip | upcase }}",
          {%- endfor -%}
        ];

        // Status Updater
        const updateStatus = (v) => {
          const statusEl = document.getElementById('tcc-fitment-status-indicator');
          if (!statusEl || !v || !v.year) return;
          
          const myKey = `${normalize(v.year)}::${normalize(v.make)}::${normalize(v.model)}::${normalize(v.submodel)}`;
          let isCompatible = compatibleKeys.includes(myKey);
          
          // Fallback (generic model match)
          if (!isCompatible) {
             const genericKey = `${normalize(v.year)}::${normalize(v.make)}::${normalize(v.model)}::`;
             if (compatibleKeys.includes(genericKey)) isCompatible = true;
          }
          
          if (isCompatible) {
            statusEl.innerHTML = `[ VERIFIED FIT: ${v.year} ${v.make} ${v.model} ${v.submodel ? v.submodel : ''} ]`;
            statusEl.className = 'tcc-status-text font-mono text-[11px] tracking-wider uppercase text-white bg-[#16a34a] px-2 py-0.5 ml-2 leading-none inline-block';
          } else {
            statusEl.innerHTML = `[ DOES NOT FIT: ${v.year} ${v.make} ${v.model} ${v.submodel ? v.submodel : ''} ]`;
            statusEl.className = 'tcc-status-text font-mono text-[11px] tracking-wider uppercase text-white bg-[#CC0000] px-2 py-0.5 ml-2 leading-none inline-block';
          }
          statusEl.classList.remove('hidden');
        };

        // --- 1. Init from LocalStorage ---
        try {
          const raw = localStorage.getItem('skm_garage_vehicle');
          if (raw) {
            const v = JSON.parse(raw);
            updateStatus(v);
          }
        } catch(e) { console.error(e); }

        // --- 2. Manual Checker Logic (Global Fetch) ---
        const yearEl = document.getElementById('tcc-manual-year');
        const makeEl = document.getElementById('tcc-manual-make');
        const modelEl = document.getElementById('tcc-manual-model');
        const submodelEl = document.getElementById('tcc-manual-submodel');
        const submodelWrapper = document.getElementById('tcc-manual-submodel-wrapper');
        const gridEl = document.getElementById('tcc-manual-grid');
        const checkBtn = document.getElementById('tcc-manual-submit');
        
        if (yearEl && makeEl && modelEl && checkBtn) {
          const index = { byYear: new Map(), byYearMake: new Map(), byYearMakeModel: new Map() };
          
          // Fetch Logic (Robust Dual-Type Check)
          const loadGlobalVehicles = async () => {
            const token = 'c9e546201d3f991f9c3f576e0d1cf4ee'; // Token from hero-ymm
            const query = `
              query getVehicles($type: String!, $first: Int!, $after: String) {
                metaobjects(type: $type, first: $first, after: $after) {
                  nodes { fields { key value } }
                  pageInfo { hasNextPage endCursor }
                }
              }
            `;
            
            // Helper to fetch all pages for a type
            const fetchPages = async (type) => {
              let collected = [];
              let after = null;
              for(let i=0; i<15; i++) { // Safety limit
                 try {
                   const res = await fetch(`/api/2025-01/graphql.json`, {
                     method: 'POST',
                     headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': token },
                     body: JSON.stringify({ query, variables: { type, first: 250, after } })
                   });
                   const json = await res.json();
                   if(!json.data || !json.data.metaobjects) break;
                   
                   collected = collected.concat(json.data.metaobjects.nodes);
                   if(!json.data.metaobjects.pageInfo.hasNextPage) break;
                   after = json.data.metaobjects.pageInfo.endCursor;
                 } catch(e) { console.error(e); break; }
              }
              return collected;
            };

            // 1. Try "vehicle" (Standard)
            let nodes = await fetchPages("vehicle");
            
            // 2. Fallback "custom.vehicle"
            if (nodes.length === 0) {
              nodes = await fetchPages("custom.vehicle");
            }
            

            // Build Index
            nodes.forEach(node => {
              const map = new Map(node.fields.map(f => [f.key, f.value]));
              const y = map.get('year');
              const m = map.get('make');
              const mod = map.get('model');
              const sub = map.get('submodel') || '';
              
              if(y && m && mod) {
                 if(!index.byYear.has(y)) index.byYear.set(y, new Set());
                 index.byYear.get(y).add(m);
                 
                 const ky = `${y}::${m}`;
                 if(!index.byYearMake.has(ky)) index.byYearMake.set(ky, new Set());
                 index.byYearMake.get(ky).add(mod);
                 
                 const kym = `${y}::${m}::${mod}`;
                 if (!index.byYearMakeModel.has(kym)) index.byYearMakeModel.set(kym, new Set());
                 if (sub) index.byYearMakeModel.get(kym).add(sub);
              }
            });
            
            // Populate Years
            yearEl.innerHTML = '<option value="">YEAR</option>';
            const years = Array.from(index.byYear.keys()).sort().reverse();
            years.forEach(y => {
              const opt = document.createElement('option');
              opt.value = y;
              opt.textContent = y;
              yearEl.appendChild(opt);
            });
          };
          
          // Interactions
          yearEl.addEventListener('change', () => {
            makeEl.innerHTML = '<option value="">MAKE</option>';
            makeEl.disabled = true;
            modelEl.innerHTML = '<option value="">MODEL</option>';
            modelEl.disabled = true;
            // Reset Submodel
            if(submodelWrapper) submodelWrapper.classList.add('hidden');
            if(gridEl) { gridEl.classList.remove('md:grid-cols-5'); gridEl.classList.add('md:grid-cols-4'); }
            if(submodelEl) submodelEl.value = '';
            
            const y = yearEl.value;
            if(y && index.byYear.has(y)) {
               const makes = Array.from(index.byYear.get(y)).sort();
               makes.forEach(m => {
                 const opt = document.createElement('option');
                 opt.value = m;
                 opt.textContent = m;
                 makeEl.appendChild(opt);
               });
               makeEl.disabled = false;
            }
          });
          
          makeEl.addEventListener('change', () => {
             modelEl.innerHTML = '<option value="">MODEL</option>';
             modelEl.disabled = true;
             // Reset Submodel
             if(submodelWrapper) submodelWrapper.classList.add('hidden');
             if(gridEl) { gridEl.classList.remove('md:grid-cols-5'); gridEl.classList.add('md:grid-cols-4'); }
             if(submodelEl) submodelEl.value = '';
             
             const y = yearEl.value;
             const m = makeEl.value;
             const key = `${y}::${m}`;
             
             if(y && m && index.byYearMake.has(key)) {
               const models = Array.from(index.byYearMake.get(key)).sort();
               models.forEach(mod => {
                 const opt = document.createElement('option');
                 opt.value = mod;
                 opt.textContent = mod;
                 modelEl.appendChild(opt);
               });
               modelEl.disabled = false;
             }
          });
          
          modelEl.addEventListener('change', () => {
             // Submodel Logic
             const y = yearEl.value;
             const m = makeEl.value;
             const mod = modelEl.value;
             const key = `${y}::${m}::${mod}`;
             
             submodelEl.innerHTML = '<option value="">SUBMODEL</option>';
             
             if (y && m && mod && index.byYearMakeModel.has(key)) {
               const submodels = index.byYearMakeModel.get(key);
               if (submodels.size > 0) {
                 // Show Submodel Dropdown
                 if(gridEl) { gridEl.classList.remove('md:grid-cols-4'); gridEl.classList.add('md:grid-cols-5'); }
                 if(submodelWrapper) submodelWrapper.classList.remove('hidden');
                 submodelEl.disabled = false;
                 
                 const subs = Array.from(submodels).sort();
                 subs.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s;
                    opt.textContent = s;
                    submodelEl.appendChild(opt);
                 });
               } else {
                 // Hide Submodel
                 if(gridEl) { gridEl.classList.remove('md:grid-cols-5'); gridEl.classList.add('md:grid-cols-4'); }
                 if(submodelWrapper) submodelWrapper.classList.add('hidden');
                 submodelEl.disabled = true;
               }
             } else {
                 if(gridEl) { gridEl.classList.remove('md:grid-cols-5'); gridEl.classList.add('md:grid-cols-4'); }
                 if(submodelWrapper) submodelWrapper.classList.add('hidden');
                 submodelEl.disabled = true;
             }
          });
          
          checkBtn.addEventListener('click', () => {
            const v = {
              year: yearEl.value,
              make: makeEl.value,
              model: modelEl.value,
              submodel: submodelEl && !submodelWrapper.classList.contains('hidden') ? submodelEl.value : ''
            };
            
            if(v.year && v.make && v.model) {
              updateStatus(v);
              // Removed localStorage saving to keep check ephemeral
            }
          });
          
          // Init Load
          // Use setTimeout to avoid blocking main thread immediately
          setTimeout(loadGlobalVehicles, 100);
        }
      });
    </script>
    
    <style>
