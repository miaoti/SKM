<!-- The Verification Protocol — Order Detail (Light Mode, redesigned) -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap');

  .order-protocol {
    --racing-red: #CC0000;
    --racing-red-soft: rgba(204, 0, 0, 0.08);
    --obsidian: #111111;
    --steel-grey: #f8f8f8;
    --card-bg: #ffffff;
    --border-color: #e5e7eb;
    --border-strong: #d1d5db;
    --data-grey: #6b7280;
    --signal-green: #16a34a;
    --signal-amber: #d97706;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .tnums { font-variant-numeric: tabular-nums; font-family: 'JetBrains Mono', ui-monospace, monospace; }

  /* HUD corner brackets */
  .hud-corner {
    position: relative;
  }
  .hud-corner::before,
  .hud-corner::after,
  .hud-corner > .hud-corner__bl,
  .hud-corner > .hud-corner__br {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
  }
  .hud-corner::before { top: -1px; left: -1px; border-top: 1.5px solid var(--racing-red); border-left: 1.5px solid var(--racing-red); }
  .hud-corner::after  { top: -1px; right: -1px; border-top: 1.5px solid var(--racing-red); border-right: 1.5px solid var(--racing-red); }
  .hud-corner > .hud-corner__bl { bottom: -1px; left: -1px; border-bottom: 1.5px solid var(--racing-red); border-left: 1.5px solid var(--racing-red); }
  .hud-corner > .hud-corner__br { bottom: -1px; right: -1px; border-bottom: 1.5px solid var(--racing-red); border-right: 1.5px solid var(--racing-red); }

  /* Signal pills */
  .signal-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--border-color);
    background: var(--card-bg);
    color: var(--obsidian);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .signal-pill .glow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal-green);
    box-shadow: 0 0 6px rgba(22, 163, 74, 0.5);
  }
  .signal-pill.is-paid     { border-color: var(--signal-green); color: var(--signal-green); }
  .signal-pill.is-refunded { border-color: var(--racing-red); color: var(--racing-red); }
  .signal-pill.is-pending  { border-color: var(--signal-amber); color: var(--signal-amber); }
  .signal-pill.is-fulfilled-emph {
    border-color: var(--racing-red);
    background: var(--racing-red);
    color: white;
  }

  /* Metrics strip */
  .metric-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 14px 18px;
    position: relative;
  }
  .metric-card .metric-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--data-grey);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .metric-card .metric-value {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
    color: var(--obsidian);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }
  .metric-card .metric-sub {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--data-grey);
    margin-top: 6px;
    letter-spacing: 0.05em;
  }
  .metric-card .metric-tick {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 28px;
    background: var(--racing-red);
  }

  /* Status timeline */
  .status-timeline {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 22px 24px 18px;
    position: relative;
  }
  .timeline-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--steps, 4), 1fr);
    gap: 0;
    margin-top: 8px;
  }
  .timeline-track::before {
    content: '';
    position: absolute;
    top: 9px;
    left: calc(100% / (var(--steps) * 2));
    right: calc(100% / (var(--steps) * 2));
    height: 1px;
    background: var(--border-color);
  }
  .timeline-step {
    position: relative;
    text-align: center;
    z-index: 1;
  }
  .timeline-step .dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: #fff;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .timeline-step.is-done .dot {
    background: var(--signal-green);
    border-color: var(--signal-green);
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
  }
  .timeline-step.is-current .dot {
    background: var(--racing-red);
    border-color: var(--racing-red);
    box-shadow: 0 0 0 3px rgba(204, 0, 0, 0.18);
    animation: tlpulse 2s ease-in-out infinite;
  }
  .timeline-step.is-error .dot {
    background: var(--racing-red);
    border-color: var(--racing-red);
  }
  @keyframes tlpulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(204, 0, 0, 0.18); }
    50%      { box-shadow: 0 0 0 6px rgba(204, 0, 0, 0.08); }
  }
  .timeline-step .label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--data-grey);
    margin-top: 8px;
    text-transform: uppercase;
  }
  .timeline-step.is-done .label,
  .timeline-step.is-current .label,
  .timeline-step.is-error .label {
    color: var(--obsidian);
  }
  .timeline-step .ts {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    color: var(--data-grey);
    margin-top: 2px;
  }

  /* Section heading */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .section-head .label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--racing-red);
    letter-spacing: 0.18em;
    font-weight: 700;
  }
  .section-head .sub {
    font-size: 11px;
    color: var(--data-grey);
  }

  /* Item card */
  .item-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 18px;
    transition: border-color 0.2s ease;
  }
  .item-card:hover { border-color: var(--racing-red); }

  .item-image {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    background: var(--steel-grey);
    border: 1px solid var(--border-color);
    overflow: hidden;
    position: relative;
  }
  .item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6) contrast(1.04);
    transition: filter 0.3s ease;
  }
  .item-card:hover .item-image img { filter: saturate(1) contrast(1.04); }
  .item-image .id-ref {
    position: absolute;
    inset: auto 0 0 0;
    background: rgba(17, 17, 17, 0.92);
    color: rgba(255,255,255,0.7);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 8px;
    letter-spacing: 0.1em;
    padding: 3px 6px;
  }

  /* Address / payment cards */
  .info-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 18px;
    height: 100%;
  }
  .info-card .info-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--racing-red);
    letter-spacing: 0.18em;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .info-card .info-body {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: #374151;
    line-height: 1.6;
  }
  .info-card .info-body strong { color: var(--obsidian); font-weight: 700; }

  /* Ledger */
  .ledger-row {
    display: flex;
    justify-content: space-between;
    padding: 9px 0;
    border-bottom: 1px solid var(--border-color);
    font-size: 13px;
  }
  .ledger-row:last-child { border-bottom: none; }
  .ledger-row.refund { color: var(--racing-red); }
  .ledger-row.total {
    border-top: 1px solid var(--obsidian);
    border-bottom: none;
    padding-top: 14px;
    margin-top: 8px;
    font-size: 16px;
    font-weight: 700;
  }
  .ledger-section-title {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--racing-red);
    letter-spacing: 0.18em;
    margin: 14px 0 4px;
    padding-top: 14px;
    border-top: 1px dashed var(--border-color);
  }

  /* Support row */
  .support-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--steel-grey);
    border: 1px solid var(--border-color);
    padding: 18px 22px;
  }
  .support-row .copy {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--obsidian);
    letter-spacing: 0.04em;
  }
  .support-row .copy .copy-sub {
    color: var(--data-grey);
    margin-top: 2px;
    font-size: 11px;
  }
  .support-row .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .support-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--obsidian);
    color: var(--obsidian);
    background: #fff;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .support-btn:hover {
    background: var(--obsidian);
    color: #fff;
  }
  .support-btn.primary {
    background: var(--racing-red);
    border-color: var(--racing-red);
    color: #fff;
  }
  .support-btn.primary:hover {
    background: #aa0000;
    border-color: #aa0000;
  }

  /* Shipments */
  .shipment-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    padding: 18px 20px;
    transition: border-color 0.2s ease;
  }
  .shipment-card:hover { border-color: var(--racing-red); }

  .shipment-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 14px;
  }
  .shipment-card__index {
    font-size: 9px;
    color: var(--data-grey);
    letter-spacing: 0.18em;
    margin-bottom: 2px;
  }
  .shipment-card__title {
    font-size: 13px;
    font-weight: 700;
    color: var(--obsidian);
    letter-spacing: 0.08em;
  }

  .shipment-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--border-color);
    background: #fff;
    color: var(--obsidian);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .shipment-status-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--data-grey);
  }
  .shipment-status-pill.is-transit  { color: #2563eb; border-color: #bfdbfe; background: #eff6ff; }
  .shipment-status-pill.is-transit  .dot { background: #2563eb; box-shadow: 0 0 6px rgba(37, 99, 235, 0.5); }
  .shipment-status-pill.is-out       { color: #d97706; border-color: #fde68a; background: #fffbeb; }
  .shipment-status-pill.is-out       .dot { background: #d97706; box-shadow: 0 0 6px rgba(217, 119, 6, 0.5); }
  .shipment-status-pill.is-attempted { color: #d97706; border-color: #fde68a; background: #fffbeb; }
  .shipment-status-pill.is-attempted .dot { background: #d97706; }
  .shipment-status-pill.is-pickup    { color: #7c3aed; border-color: #ddd6fe; background: #f5f3ff; }
  .shipment-status-pill.is-pickup    .dot { background: #7c3aed; }
  .shipment-status-pill.is-delivered { color: var(--signal-green); border-color: #bbf7d0; background: #f0fdf4; }
  .shipment-status-pill.is-delivered .dot { background: var(--signal-green); box-shadow: 0 0 6px rgba(22, 163, 74, 0.5); }
  .shipment-status-pill.is-failure   { color: var(--racing-red); border-color: #fecaca; background: #fef2f2; }
  .shipment-status-pill.is-failure   .dot { background: var(--racing-red); }
  .shipment-status-pill.is-pending   { color: #6b7280; border-color: #e5e7eb; background: #f9fafb; }
  .shipment-status-pill.is-pending   .dot { background: #9ca3af; }

  .shipment-card__body { display: flex; flex-direction: column; gap: 14px; }
  .shipment-meta { display: flex; flex-direction: column; gap: 6px; }
  .shipment-meta__row {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
  }
  .shipment-meta__key {
    font-size: 10px;
    color: var(--data-grey);
    letter-spacing: 0.16em;
    width: 84px;
    flex-shrink: 0;
  }
  .shipment-meta__val { color: var(--obsidian); }
  .shipment-meta__val--muted { color: var(--data-grey); }
  .shipment-link {
    color: var(--racing-red);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }
  .shipment-link:hover { color: #aa0000; text-decoration: underline; }

  .shipment-items {
    border-top: 1px dashed var(--border-color);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .shipment-items__label {
    font-size: 9px;
    color: var(--racing-red);
    letter-spacing: 0.18em;
    margin-bottom: 4px;
  }
  .shipment-item {
    font-size: 12px;
    color: #374151;
    line-height: 1.5;
  }
  .shipment-item__qty {
    color: var(--racing-red);
    font-weight: 700;
    margin-right: 8px;
  }
  .shipment-item__variant {
    font-size: 11px;
    color: var(--data-grey);
    margin-left: 4px;
  }

  /* Layout helpers */
  .grid-12 {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    .grid-12 { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 540px) {
    .grid-12 { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
</style>

<div class="order-protocol bg-white min-h-screen text-[#111111]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">

    {%- comment -%} ===== Breadcrumb ===== {%- endcomment -%}
    <nav class="mb-6">
      <a href="/account" class="mono text-xs text-[#6b7280] hover:text-[#CC0000] transition-colors tracking-widest">
        DIRECTORY // ACCOUNT // ORDER_LOG
      </a>
    </nav>

    {%- comment -%} ===== Header ===== {%- endcomment -%}
    <header class="mb-8 pb-6 border-b border-gray-200">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5">
        <div>
          <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-[#111111]">
            ORDER RECORD: {{ order.name }}
          </h1>
          <p class="mono text-xs text-[#6b7280] mt-2 tracking-widest">
            TIMESTAMP: {{ order.created_at | date: "%Y-%m-%d // %H:%M:%S UTC" }}
          </p>
        </div>

        {%- liquid
          assign payment_status = order.financial_status | downcase
          assign fulfillment_status_raw = order.fulfillment_status | downcase
          if fulfillment_status_raw == blank
            assign fulfillment_status_raw = 'unfulfilled'
          endif
        -%}
        <div class="flex flex-wrap gap-2">
          <span class="signal-pill mono
            {% if payment_status == 'paid' %}is-paid
            {% elsif payment_status == 'refunded' or payment_status == 'partially_refunded' %}is-refunded
            {% elsif payment_status == 'pending' or payment_status == 'authorized' %}is-pending
            {% endif %}">
            {% if payment_status == 'paid' %}<span class="glow-dot"></span>{% endif %}
            {{ order.financial_status_label | upcase }}
          </span>
          <span class="signal-pill mono
            {% if fulfillment_status_raw == 'fulfilled' %}is-fulfilled-emph{% endif %}">
            {{ order.fulfillment_status_label | default: 'PROCESSING' | upcase }}
          </span>
        </div>
      </div>
    </header>

    {%- comment -%} ===== Top metrics strip ===== {%- endcomment -%}
    {%- liquid
      assign item_count = 0
      for li in order.line_items
        assign item_count = item_count | plus: li.quantity
      endfor
    -%}
    <div class="grid-12 mb-8">
      <div class="metric-card hud-corner" style="grid-column: span 3;">
        <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>
        <span class="metric-tick"></span>
        <div class="metric-label">Total</div>
        <div class="metric-value">{{ order.total_price | money }}</div>
        <div class="metric-sub">{{ order.currency }}</div>
      </div>
      <div class="metric-card" style="grid-column: span 3;">
        <span class="metric-tick"></span>
        <div class="metric-label">Components</div>
        <div class="metric-value">{{ item_count }}</div>
        <div class="metric-sub">{{ order.line_items.size }} unique sku{% if order.line_items.size != 1 %}s{% endif %}</div>
      </div>
      <div class="metric-card" style="grid-column: span 3;">
        <span class="metric-tick"></span>
        <div class="metric-label">Shipping</div>
        <div class="metric-value">
          {% if order.shipping_price > 0 %}{{ order.shipping_price | money }}{% else %}WAIVED{% endif %}
        </div>
        <div class="metric-sub">{% if order.shipping_methods.size > 0 %}{{ order.shipping_methods.first.title | upcase }}{% else %}STANDARD{% endif %}</div>
      </div>
      <div class="metric-card" style="grid-column: span 3;">
        <span class="metric-tick"></span>
        <div class="metric-label">Payment</div>
        {%- liquid
          assign gateway_name = ''
          for transaction in order.transactions
            if transaction.kind == 'sale' or transaction.kind == 'capture' or transaction.kind == 'authorization'
              assign gateway_name = transaction.gateway
              break
            endif
          endfor
        -%}
        <div class="metric-value" style="font-size: 14px;">
          {{ gateway_name | default: 'PENDING' | replace: '_', ' ' | replace: 'shopify payments', 'SECURE_CARD' | upcase }}
        </div>
        <div class="metric-sub">{{ order.financial_status_label | upcase }}</div>
      </div>
    </div>

    {%- comment -%} ===== Status timeline =====
       Steps: Placed → Paid → Fulfilled → Delivered. If refunded, last
       step shows refund instead. {%- endcomment -%}
    {%- liquid
      assign step_placed = true
      assign step_paid = false
      if payment_status == 'paid' or payment_status == 'partially_paid' or payment_status == 'refunded' or payment_status == 'partially_refunded'
        assign step_paid = true
      endif
      assign step_fulfilled = false
      if fulfillment_status_raw == 'fulfilled' or fulfillment_status_raw == 'partial'
        assign step_fulfilled = true
      endif
      assign step_delivered = false
      for fulfillment in order.fulfillments
        if fulfillment.shipment_status == 'delivered'
          assign step_delivered = true
        endif
      endfor
      assign step_refunded = false
      if payment_status == 'refunded' or payment_status == 'partially_refunded'
        assign step_refunded = true
      endif
    -%}
    <div class="status-timeline mb-8">
      <div class="section-head">
        <span class="label">// PROGRESS</span>
        <span class="sub">Order journey</span>
      </div>
      <div class="timeline-track" style="--steps: 4;">
        <div class="timeline-step is-done">
          <div class="dot"></div>
          <div class="label">Placed</div>
          <div class="ts">{{ order.created_at | date: "%b %d" }}</div>
        </div>
        <div class="timeline-step {% if step_paid %}is-done{% endif %}">
          <div class="dot"></div>
          <div class="label">Paid</div>
          <div class="ts">{% if step_paid %}{{ order.financial_status_label | upcase }}{% else %}—{% endif %}</div>
        </div>
        {% if step_refunded %}
          <div class="timeline-step is-error">
            <div class="dot"></div>
            <div class="label">Refunded</div>
            <div class="ts">CREDIT ISSUED</div>
          </div>
        {% else %}
          <div class="timeline-step {% if step_fulfilled %}is-done{% elsif step_paid %}is-current{% endif %}">
            <div class="dot"></div>
            <div class="label">Fulfilled</div>
            <div class="ts">{% if step_fulfilled %}SHIPPED{% else %}PENDING{% endif %}</div>
          </div>
        {% endif %}
        <div class="timeline-step {% if step_delivered %}is-done{% elsif step_fulfilled %}is-current{% endif %}">
          <div class="dot"></div>
          <div class="label">Delivered</div>
          <div class="ts">{% if step_delivered %}COMPLETE{% else %}—{% endif %}</div>
        </div>
      </div>
    </div>

    {%- comment -%}
      ===== Shipments =====
      Reads Shopify's standard customer-order Liquid object — no API
      call needed. Each `fulfillment` exposes:
        - tracking_numbers (array) + tracking_urls (array) — used so
          multi-package shipments under one fulfillment all show
        - tracking_company — carrier name (e.g. "UPS", "FedEx"); we
          fall back to "Carrier" when a manual fulfillment didn't fill
          this in
        - shipment_status — set automatically by Shopify Shipping or
          via the carrier integration. May be nil on manual
          fulfillments where the merchant only typed in a tracking
          number; we degrade to "Awaiting carrier scan" so the user
          sees something coherent
        - fulfillment_line_items — gives us the FULFILLED quantity per
          line item (more accurate than fulfillment.line_items, which
          can echo the original ordered qty)
        - created_at — when fulfillment was created in Shopify

      The section only renders when at least one fulfillment exists.
      For pre-fulfillment orders, the timeline above already shows
      "Fulfilled · pending".
    {%- endcomment -%}
    {% if order.fulfillments.size > 0 %}
      <div class="mb-8">
        <div class="section-head">
          <span class="label">// SHIPMENTS</span>
          <span class="sub">{{ order.fulfillments.size }} {% if order.fulfillments.size == 1 %}package{% else %}packages{% endif %}</span>
        </div>

        <div class="space-y-4">
          {% for fulfillment in order.fulfillments %}
            {%- liquid
              assign ship_status_raw = fulfillment.shipment_status
              assign has_tracking_number = false
              if fulfillment.tracking_numbers.size > 0 or fulfillment.tracking_number != blank
                assign has_tracking_number = true
              endif

              # Derive a sensible status when Shopify hasn't reported one.
              # `shipment_status` only populates for carriers that report
              # back to Shopify (USPS, UPS, FedEx via Shopify Shipping).
              # Manual fulfillments stay nil — surface that as
              # "AWAITING CARRIER SCAN" instead of a misleading default.
              assign ship_status = ship_status_raw | downcase
              if ship_status == blank
                if has_tracking_number
                  assign ship_status = 'awaiting_scan'
                else
                  assign ship_status = 'fulfilled'
                endif
              endif

              assign ship_status_label = ship_status | replace: '_', ' ' | upcase
              assign ship_status_class = 'is-transit'
              if ship_status == 'delivered'
                assign ship_status_class = 'is-delivered'
              elsif ship_status == 'out_for_delivery'
                assign ship_status_class = 'is-out'
              elsif ship_status == 'failure'
                assign ship_status_class = 'is-failure'
              elsif ship_status == 'attempted_delivery'
                assign ship_status_class = 'is-attempted'
              elsif ship_status == 'ready_for_pickup'
                assign ship_status_class = 'is-pickup'
              elsif ship_status == 'awaiting_scan'
                assign ship_status_class = 'is-pending'
                assign ship_status_label = 'AWAITING CARRIER SCAN'
              elsif ship_status == 'fulfilled'
                assign ship_status_class = 'is-pending'
                assign ship_status_label = 'AWAITING TRACKING'
              endif
            -%}
            <div class="shipment-card hud-corner">
              <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>

              <div class="shipment-card__head">
                <div>
                  <div class="shipment-card__index mono">PACKAGE {{ forloop.index }} OF {{ order.fulfillments.size }}</div>
                  <div class="shipment-card__title mono">
                    {%- if fulfillment.tracking_company != blank -%}
                      {{ fulfillment.tracking_company | upcase }}
                    {%- else -%}
                      CARRIER
                    {%- endif -%}
                  </div>
                </div>
                <span class="shipment-status-pill mono {{ ship_status_class }}">
                  <span class="dot"></span>{{ ship_status_label }}
                </span>
              </div>

              <div class="shipment-card__body">
                <div class="shipment-meta">
                  {%- comment -%}
                    Render every tracking number on the fulfillment, not just
                    the first. Some carriers split a single fulfillment into
                    multiple packages with separate tracking IDs.
                  {%- endcomment -%}
                  {% if fulfillment.tracking_numbers.size > 0 %}
                    {% for tn in fulfillment.tracking_numbers %}
                      {%- assign turl = fulfillment.tracking_urls[forloop.index0] | default: fulfillment.tracking_url -%}
                      <div class="shipment-meta__row">
                        <span class="shipment-meta__key mono">{% if forloop.first %}TRACKING{% else %}&nbsp;{% endif %}</span>
                        <span class="shipment-meta__val mono">
                          {% if turl != blank %}
                            <a href="{{ turl }}" target="_blank" rel="noopener" class="shipment-link">
                              {{ tn }}
                              <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="margin-left: 4px; display: inline-block; vertical-align: -1px;"><path stroke-linecap="round" stroke-linejoin="round" d="M14 3h7v7m0-7L10 14M5 5h4v4M5 5v9a2 2 0 002 2h9"/></svg>
                            </a>
                          {% else %}
                            {{ tn }}
                          {% endif %}
                        </span>
                      </div>
                    {% endfor %}
                  {% elsif fulfillment.tracking_number != blank %}
                    <div class="shipment-meta__row">
                      <span class="shipment-meta__key mono">TRACKING</span>
                      <span class="shipment-meta__val mono">
                        {% if fulfillment.tracking_url != blank %}
                          <a href="{{ fulfillment.tracking_url }}" target="_blank" rel="noopener" class="shipment-link">
                            {{ fulfillment.tracking_number }}
                            <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="margin-left: 4px; display: inline-block; vertical-align: -1px;"><path stroke-linecap="round" stroke-linejoin="round" d="M14 3h7v7m0-7L10 14M5 5h4v4M5 5v9a2 2 0 002 2h9"/></svg>
                          </a>
                        {% else %}
                          {{ fulfillment.tracking_number }}
                        {% endif %}
                      </span>
                    </div>
                  {% else %}
                    <div class="shipment-meta__row">
                      <span class="shipment-meta__key mono">TRACKING</span>
                      <span class="shipment-meta__val shipment-meta__val--muted mono">Not yet provided</span>
                    </div>
                  {% endif %}

                  {% if fulfillment.created_at %}
                    <div class="shipment-meta__row">
                      <span class="shipment-meta__key mono">SHIPPED</span>
                      <span class="shipment-meta__val mono">{{ fulfillment.created_at | date: "%Y-%m-%d %H:%M" }}</span>
                    </div>
                  {% endif %}
                </div>

                {%- comment -%}
                  Prefer fulfillment_line_items because its `quantity`
                  reflects the FULFILLED quantity, not the ordered
                  quantity. Fall back to fulfillment.line_items if
                  fulfillment_line_items is missing for any reason.
                {%- endcomment -%}
                {% if fulfillment.fulfillment_line_items.size > 0 %}
                  <div class="shipment-items">
                    <div class="shipment-items__label mono">CONTENTS</div>
                    {% for fli in fulfillment.fulfillment_line_items %}
                      <div class="shipment-item">
                        <span class="shipment-item__qty mono">{{ fli.quantity }}×</span>
                        <span class="shipment-item__title">{{ fli.line_item.title }}</span>
                        {% if fli.line_item.variant.title and fli.line_item.variant.title != 'Default Title' %}
                          <span class="shipment-item__variant mono">· {{ fli.line_item.variant.title }}</span>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                {% elsif fulfillment.line_items.size > 0 %}
                  <div class="shipment-items">
                    <div class="shipment-items__label mono">CONTENTS</div>
                    {% for line_item in fulfillment.line_items %}
                      <div class="shipment-item">
                        <span class="shipment-item__qty mono">{{ line_item.quantity }}×</span>
                        <span class="shipment-item__title">{{ line_item.title }}</span>
                        {% if line_item.variant.title and line_item.variant.title != 'Default Title' %}
                          <span class="shipment-item__variant mono">· {{ line_item.variant.title }}</span>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {%- comment -%} ===== Items + Ledger ===== {%- endcomment -%}
    <div class="grid-12 mb-8">

      <div style="grid-column: span 8;">
        <div class="section-head">
          <span class="label">// MANIFEST_CONTENTS</span>
          <span class="sub">{{ order.line_items.size }} component{% if order.line_items.size != 1 %}s{% endif %}</span>
        </div>

        <div class="space-y-4">
          {% for line_item in order.line_items %}
            <div class="item-card hud-corner">
              <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>

              <div class="flex gap-4 sm:gap-5">
                <div class="item-image">
                  {% if line_item.image %}
                    <img src="{{ line_item.image | image_url: width: 240 }}" alt="{{ line_item.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="w-full h-full flex items-center justify-center"><span class="mono text-[10px] text-gray-400">NO_IMG</span></div>
                  {% endif %}
                  {% if line_item.sku != blank %}
                    <span class="id-ref">SKU: {{ line_item.sku }}</span>
                  {% endif %}
                </div>

                <div class="flex-grow min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                    <div class="min-w-0">
                      {% if line_item.product.url %}
                        <a href="{{ line_item.product.url }}" class="block font-bold text-[#111111] hover:text-[#CC0000] transition-colors text-sm sm:text-base leading-snug">
                          {{ line_item.title }}
                        </a>
                      {% else %}
                        <p class="font-bold text-[#111111] text-sm sm:text-base leading-snug">{{ line_item.title }}</p>
                      {% endif %}
                      {% if line_item.variant.title != 'Default Title' %}
                        <p class="mono text-xs text-[#6b7280] mt-1 tracking-wider">
                          SPEC: {{ line_item.variant.title }}
                        </p>
                      {% endif %}
                      <p class="mono text-xs text-[#6b7280] mt-2">
                        QTY {{ line_item.quantity }} <span class="text-gray-300">×</span> {{ line_item.final_price | money }}
                      </p>
                    </div>

                    <div class="text-left sm:text-right flex-shrink-0">
                      <p class="tnums font-bold text-[#111111] text-base">{{ line_item.final_line_price | money }}</p>
                      {% if line_item.original_line_price != line_item.final_line_price %}
                        <p class="tnums text-xs text-gray-400 line-through">{{ line_item.original_line_price | money }}</p>
                      {% endif %}
                    </div>
                  </div>

                  {%- comment -%} Tracking strip {%- endcomment -%}
                  {% if line_item.fulfillment %}
                    <div class="mt-3 pt-3 border-t border-gray-200 flex items-center gap-3">
                      <span class="mono text-[10px] text-[#6b7280] tracking-widest">TRACKING</span>
                      {% if line_item.fulfillment.tracking_url %}
                        <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener"
                           class="mono text-xs text-[#CC0000] hover:underline">
                          {{ line_item.fulfillment.tracking_number | default: 'PENDING' }}
                          <span class="text-[#9ca3af] ml-1">[{{ line_item.fulfillment.tracking_company | default: 'CARRIER' }}]</span>
                        </a>
                      {% elsif line_item.fulfillment.tracking_number %}
                        <span class="mono text-xs text-[#111111]">{{ line_item.fulfillment.tracking_number }}</span>
                      {% else %}
                        <span class="mono text-xs text-[#6b7280]">PROCESSING…</span>
                      {% endif %}
                    </div>
                  {% else %}
                    <div class="mt-3 pt-3 border-t border-gray-200">
                      <span class="mono text-[10px] text-[#6b7280] tracking-widest">STATUS:</span>
                      <span class="mono text-xs text-[#6b7280] ml-2">LOGISTICS_PROCESSING…</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {%- comment -%} ===== Financial ledger ===== {%- endcomment -%}
      <div style="grid-column: span 4;">
        <div class="section-head">
          <span class="label">// FINANCIAL_LEDGER</span>
        </div>
        <div class="info-card hud-corner">
          <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>

          <div class="ledger-row">
            <span class="text-xs text-[#6b7280] uppercase tracking-wider">Subtotal</span>
            <span class="tnums text-[#111111]">{{ order.line_items_subtotal_price | money }}</span>
          </div>

          {% for discount in order.cart_level_discount_applications %}
            <div class="ledger-row">
              <span class="text-xs text-green-700 uppercase tracking-wider">Discount · {{ discount.title }}</span>
              <span class="tnums text-green-700">-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {% endfor %}

          <div class="ledger-row">
            <span class="text-xs text-[#6b7280] uppercase tracking-wider">Shipping</span>
            {% if order.shipping_price > 0 %}
              <span class="tnums text-[#111111]">{{ order.shipping_price | money }}</span>
            {% else %}
              <span class="tnums text-green-700">WAIVED</span>
            {% endif %}
          </div>

          {% if order.tax_price > 0 %}
            <div class="ledger-row">
              <span class="text-xs text-[#6b7280] uppercase tracking-wider">Tax</span>
              <span class="tnums text-[#111111]">{{ order.tax_price | money }}</span>
            </div>
          {% endif %}

          <div class="ledger-row total">
            <span class="text-xs text-[#111111] uppercase tracking-widest">Total</span>
            <span class="tnums text-[#111111]">{{ order.total_price | money }}</span>
          </div>

          {% if step_refunded %}
            <div class="ledger-section-title">REFUND_ADJUSTMENT</div>
            {% for transaction in order.transactions %}
              {% if transaction.kind == 'refund' %}
                <div class="ledger-row refund">
                  <span class="text-xs uppercase tracking-wider">Credit issued</span>
                  <span class="tnums">-{{ transaction.amount | money }}</span>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

    </div>

    {%- comment -%} ===== Ship_to / Bill_to / Payment 3-column row ===== {%- endcomment -%}
    <div class="grid-12 mb-8">
      <div style="grid-column: span 4;">
        <div class="info-card hud-corner">
          <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>
          <div class="info-label">SHIP_TO</div>
          {% if order.shipping_address %}
            <div class="info-body">
              <strong>{{ order.shipping_address.name }}</strong>
              {% if order.shipping_address.company %}<br>{{ order.shipping_address.company }}{% endif %}
              <br>{{ order.shipping_address.address1 }}
              {% if order.shipping_address.address2 %}<br>{{ order.shipping_address.address2 }}{% endif %}
              <br>{{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}
              <br>{{ order.shipping_address.country }}
            </div>
          {% else %}
            <p class="mono text-xs text-gray-400">NO_PHYSICAL_DELIVERY</p>
          {% endif %}
        </div>
      </div>

      <div style="grid-column: span 4;">
        <div class="info-card hud-corner">
          <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>
          <div class="info-label">BILL_TO</div>
          {% if order.billing_address %}
            <div class="info-body">
              <strong>{{ order.billing_address.name }}</strong>
              {% if order.billing_address.company %}<br>{{ order.billing_address.company }}{% endif %}
              <br>{{ order.billing_address.address1 }}
              {% if order.billing_address.address2 %}<br>{{ order.billing_address.address2 }}{% endif %}
              <br>{{ order.billing_address.city }}, {{ order.billing_address.province_code }} {{ order.billing_address.zip }}
              <br>{{ order.billing_address.country }}
            </div>
          {% else %}
            <p class="mono text-xs text-gray-400">SAME_AS_SHIPPING</p>
          {% endif %}
        </div>
      </div>

      <div style="grid-column: span 4;">
        <div class="info-card hud-corner">
          <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>
          <div class="info-label">PAYMENT_GATEWAY</div>
          {% assign found_tx = false %}
          {% for transaction in order.transactions %}
            {% if transaction.kind == 'sale' or transaction.kind == 'capture' or transaction.kind == 'authorization' %}
              {% assign found_tx = true %}
              <div class="flex items-start gap-3">
                <div class="w-10 h-7 bg-gray-100 border border-gray-200 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-[#6b7280]">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                  </svg>
                </div>
                <div class="info-body">
                  <strong>{{ transaction.gateway | replace: '_', ' ' | replace: 'shopify payments', 'SECURE_CARD' | upcase }}</strong>
                  <br><span class="tnums text-[#111111]">{{ transaction.amount | money }}</span>
                  <br><span class="text-[#6b7280] text-[11px]">{{ transaction.created_at | date: "%Y-%m-%d %H:%M" }}</span>
                </div>
              </div>
              {% break %}
            {% endif %}
          {% endfor %}
          {% unless found_tx %}
            <p class="mono text-xs text-gray-400">NO_TRANSACTION_RECORDED</p>
          {% endunless %}
        </div>
      </div>
    </div>

    {%- comment -%}
      ===== Refund-request state =====
      Reads the custom.refund_request metafield set by the worker.
      Renders the right banner for the LATEST request based on status:
        - pending      → orange "pending review" banner with Cancel
        - rejected     → red "request declined" banner with admin note
        - approved     → green "refund issued" banner
        - cancelled    → grey "request cancelled" banner (small)
      Anything older than the latest gets summarised in a history strip
      below so the customer always has a paper trail.
    {%- endcomment -%}
    {%- liquid
      assign refund_requests_value = order.metafields.custom.refund_request.value
      assign pending_refund_request = nil
      assign last_refund_request = nil
      assign request_history = ''
      if refund_requests_value
        for req in refund_requests_value
          if last_refund_request == nil
            assign last_refund_request = req
          endif
          if req.status == 'pending' and pending_refund_request == nil
            assign pending_refund_request = req
          endif
        endfor
      endif

      assign last_status = ''
      if last_refund_request
        assign last_status = last_refund_request.status
      endif

      assign payment_status_lc = order.financial_status | downcase
      assign can_request_refund = false
      if customer
        if payment_status_lc == 'paid' or payment_status_lc == 'partially_paid' or payment_status_lc == 'partially_refunded'
          if pending_refund_request == nil
            assign can_request_refund = true
          endif
        endif
      endif
    -%}

    {% if pending_refund_request %}
      {%- assign refund_signature = customer.id | hmac_sha256: "skm-customer-update-secret" -%}
      <div class="refund-banner refund-banner--pending mb-6" data-pending-id="{{ pending_refund_request.id }}">
        <div class="refund-banner__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="refund-banner__body">
          <div class="refund-banner__title mono">REFUND REQUESTED · PENDING REVIEW</div>
          <div class="refund-banner__sub">
            Submitted {{ pending_refund_request.requestedAt | date: "%Y-%m-%d %H:%M UTC" }} ·
            Reason: {{ pending_refund_request.reason | replace: '_', ' ' | upcase }}
            {% if pending_refund_request.notes != blank %} · "{{ pending_refund_request.notes | truncate: 80 }}"{% endif %}
          </div>
          <div class="refund-banner__sub" style="margin-top: 4px;">
            Our team will review the request and reply by email. You can cancel and re-submit at any time before we process it.
          </div>
          <div class="refund-banner__actions" style="margin-top: 12px;">
            <button type="button" id="btn-cancel-refund-request" class="refund-banner__cancel-btn">
              Cancel request
            </button>
            <span id="refund-cancel-error" class="refund-banner__sub" style="color: #991b1b; margin-left: 12px;" hidden></span>
          </div>
        </div>
      </div>
      <script>
        (function () {
          var btn = document.getElementById('btn-cancel-refund-request');
          if (!btn) return;
          var errEl = document.getElementById('refund-cancel-error');
          var customerId = {{ customer.id | json }};
          var customerSig = {{ refund_signature | json }};
          var requestId = {{ pending_refund_request.id | json }};
          var orderId = {{ order.id | json }};
          var workerBase = 'https://skm-inventory-api.miaotingshuo.workers.dev';

          btn.addEventListener('click', async function () {
            var ok = window.confirm('Cancel this refund request? You can submit a new one afterward.');
            if (!ok) return;
            errEl.hidden = true; errEl.textContent = '';
            btn.disabled = true; btn.textContent = 'Cancelling…';
            try {
              var numericOrder = String(orderId).split('/').pop();
              var res = await fetch(
                workerBase + '/orders/' + numericOrder + '/refund-requests/' + encodeURIComponent(requestId),
                {
                  method: 'DELETE',
                  headers: {
                    'Content-Type': 'application/json',
                    'X-Customer-Signature': customerSig
                  },
                  body: JSON.stringify({ customerId: customerId })
                }
              );
              var json = await res.json();
              if (!res.ok || !json.success) {
                throw new Error(json.error || ('HTTP ' + res.status));
              }
              window.location.reload();
            } catch (err) {
              errEl.textContent = err.message || 'Failed to cancel.';
              errEl.hidden = false;
              btn.disabled = false;
              btn.textContent = 'Cancel request';
            }
          });
        })();
      </script>
    {% elsif last_status == 'rejected' %}
      <div class="refund-banner refund-banner--rejected mb-6">
        <div class="refund-banner__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
        </div>
        <div class="refund-banner__body">
          <div class="refund-banner__title mono">REFUND REQUEST DECLINED</div>
          <div class="refund-banner__sub">
            Reason on file: {{ last_refund_request.reason | replace: '_', ' ' | upcase }}
            {% if last_refund_request.reviewedAt %} · Reviewed {{ last_refund_request.reviewedAt | date: "%Y-%m-%d %H:%M UTC" }}{% endif %}
          </div>
          <div class="refund-banner__sub" style="margin-top: 4px;">
            {% if last_refund_request.adminNote != blank %}<strong>Note from our team:</strong> {{ last_refund_request.adminNote }}{% else %}Please contact support if you need to discuss this decision.{% endif %}
          </div>
        </div>
      </div>
    {% elsif last_status == 'approved' or last_status == 'completed' %}
      <div class="refund-banner refund-banner--approved mb-6">
        <div class="refund-banner__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="refund-banner__body">
          <div class="refund-banner__title mono">REFUND APPROVED</div>
          <div class="refund-banner__sub">
            Your refund request has been approved
            {% if last_refund_request.reviewedAt %} on {{ last_refund_request.reviewedAt | date: "%Y-%m-%d" }}{% endif %}.
            Funds typically post to the original payment method within 5–10 business days.
          </div>
          {% if last_refund_request.adminNote != blank %}
            <div class="refund-banner__sub" style="margin-top: 4px;"><strong>Note from our team:</strong> {{ last_refund_request.adminNote }}</div>
          {% endif %}
        </div>
      </div>
    {% elsif last_status == 'cancelled' %}
      <div class="refund-banner refund-banner--cancelled mb-6">
        <div class="refund-banner__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="refund-banner__body">
          <div class="refund-banner__title mono">REFUND REQUEST CANCELLED</div>
          <div class="refund-banner__sub">
            You cancelled this request{% if last_refund_request.cancelledAt %} on {{ last_refund_request.cancelledAt | date: "%Y-%m-%d %H:%M UTC" }}{% endif %}. You can submit a new one any time.
          </div>
        </div>
      </div>
    {% endif %}

    {%- comment -%}
      ===== Refund history =====
      Always render past requests (status != latest) so the customer
      has visibility regardless of the active banner.
    {%- endcomment -%}
    {% if refund_requests_value and refund_requests_value.size > 1 %}
      <details class="refund-history mb-6">
        <summary class="refund-history__summary mono">
          Refund request history ({{ refund_requests_value.size }})
        </summary>
        <div class="refund-history__list">
          {% for req in refund_requests_value %}
            {%- liquid
              assign req_status = req.status | default: 'unknown'
              assign req_pill_class = 'is-pending'
              if req_status == 'rejected'
                assign req_pill_class = 'is-rejected'
              elsif req_status == 'approved' or req_status == 'completed'
                assign req_pill_class = 'is-approved'
              elsif req_status == 'cancelled'
                assign req_pill_class = 'is-cancelled'
              endif
            -%}
            <div class="refund-history__item">
              <span class="refund-history__pill {{ req_pill_class }} mono">{{ req_status | upcase }}</span>
              <span class="refund-history__meta mono">
                {{ req.requestedAt | date: "%Y-%m-%d %H:%M" }}
                · {{ req.reason | replace: '_', ' ' | upcase }}
                {% if req.reviewedAt %} · reviewed {{ req.reviewedAt | date: "%Y-%m-%d" }}{% endif %}
                {% if req.cancelledAt %} · cancelled {{ req.cancelledAt | date: "%Y-%m-%d" }}{% endif %}
              </span>
            </div>
          {% endfor %}
        </div>
      </details>
    {% endif %}

    {%- comment -%} ===== Support / actions row ===== {%- endcomment -%}
    <div class="support-row">
      <div class="copy">
        <div>NEED ASSISTANCE WITH THIS ORDER?</div>
        <div class="copy-sub">Reference {{ order.name }} when contacting support.</div>
      </div>
      <div class="actions">
        {% if order.order_status_url %}
          <a href="{{ order.order_status_url }}" class="support-btn">
            View Order Status
          </a>
        {% endif %}
        {% if can_request_refund %}
          <button type="button" id="btn-open-refund-modal" class="support-btn primary">
            Request Refund
          </button>
        {% endif %}
        <a href="/pages/contact" class="support-btn">
          Contact Support
        </a>
      </div>
    </div>

    {%- comment -%} ===== Refund modal ===== {%- endcomment -%}
    {% if can_request_refund %}
      {%- assign refund_signature = customer.id | hmac_sha256: "skm-customer-update-secret" -%}
      <dialog id="refund-modal" class="refund-modal">
        <div class="refund-modal__panel hud-corner">
          <span class="hud-corner__bl"></span><span class="hud-corner__br"></span>

          <div class="refund-modal__header">
            <div>
              <div class="mono refund-modal__eyebrow">// REQUEST_REFUND</div>
              <h3 class="refund-modal__title">Order {{ order.name }}</h3>
            </div>
            <button type="button" class="refund-modal__close" aria-label="Close" data-refund-close>
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <form id="refund-form" class="refund-modal__body">
            <div class="refund-field">
              <label class="refund-field__label mono">REASON</label>
              <select id="refund-reason" class="refund-field__input" required>
                <option value="">Select a reason</option>
                <option value="refund">General refund</option>
                <option value="exchange">Exchange / wrong size or fitment</option>
                <option value="damaged">Item arrived damaged</option>
                <option value="wrong_item">Received wrong item</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="refund-field">
              <label class="refund-field__label mono">ITEMS · select what you'd like refunded</label>
              <div class="refund-items">
                {% for line_item in order.line_items %}
                  {%- assign refundable_qty = line_item.quantity | minus: line_item.refunded_quantity -%}
                  <label class="refund-item" data-line-id="{{ line_item.id }}" {% if refundable_qty == 0 %}data-disabled="true"{% endif %}>
                    <input type="checkbox" class="refund-item__check"
                      data-line-id="{{ line_item.id }}"
                      data-max-qty="{{ refundable_qty }}"
                      {% if refundable_qty == 0 %}disabled{% endif %}>
                    <div class="refund-item__main">
                      <div class="refund-item__title">{{ line_item.title }}</div>
                      <div class="refund-item__meta mono">
                        {% if line_item.variant.title != 'Default Title' %}{{ line_item.variant.title }} · {% endif %}
                        {{ line_item.final_price | money }} each ·
                        {% if refundable_qty == 0 %}
                          <span style="color: var(--data-grey);">already refunded</span>
                        {% else %}
                          {{ refundable_qty }} of {{ line_item.quantity }} eligible
                        {% endif %}
                      </div>
                    </div>
                    <div class="refund-item__qty">
                      <span class="mono refund-item__qty-label">QTY</span>
                      <input type="number" min="1" max="{{ refundable_qty }}" value="{{ refundable_qty }}"
                        class="refund-item__qty-input"
                        {% if refundable_qty == 0 %}disabled{% endif %}>
                    </div>
                  </label>
                {% endfor %}
              </div>
            </div>

            <div class="refund-field">
              <label class="refund-field__label mono">NOTES <span style="color: var(--data-grey); font-weight: 400;">(optional · 1000 max)</span></label>
              <textarea id="refund-notes" class="refund-field__input refund-field__textarea" rows="3" maxlength="1000" placeholder="Briefly describe what happened, photos can be sent via email reply afterward."></textarea>
            </div>

            <div id="refund-error" class="refund-error" hidden></div>

            <div class="refund-modal__footer">
              <button type="button" class="support-btn" data-refund-close>Cancel</button>
              <button type="submit" id="refund-submit" class="support-btn primary">Submit Request</button>
            </div>
          </form>

          <div id="refund-success" class="refund-success" hidden>
            <div class="refund-success__icon">
              <svg width="34" height="34" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div class="refund-success__title mono">REQUEST RECEIVED</div>
            <p class="refund-success__sub">We'll review and reply by email. Refresh this page to see the pending status.</p>
            <button type="button" class="support-btn primary" onclick="window.location.reload()">Reload</button>
          </div>
        </div>
      </dialog>

      <script>
        (function () {
          var modal = document.getElementById('refund-modal');
          var openBtn = document.getElementById('btn-open-refund-modal');
          var form = document.getElementById('refund-form');
          var errorBox = document.getElementById('refund-error');
          var success = document.getElementById('refund-success');
          var submitBtn = document.getElementById('refund-submit');
          var customerId = {{ customer.id | json }};
          var customerSig = {{ refund_signature | json }};
          var orderId = {{ order.id | json }};
          var workerBase = 'https://skm-inventory-api.miaotingshuo.workers.dev';

          if (!modal || !openBtn) return;

          openBtn.addEventListener('click', function () {
            errorBox.hidden = true; errorBox.textContent = '';
            modal.showModal();
          });

          modal.querySelectorAll('[data-refund-close]').forEach(function (b) {
            b.addEventListener('click', function () { modal.close(); });
          });
          modal.addEventListener('click', function (e) {
            if (e.target === modal) modal.close();
          });

          // Toggle qty input enable/disable based on checkbox.
          modal.querySelectorAll('.refund-item__check').forEach(function (cb) {
            var row = cb.closest('.refund-item');
            var qtyInput = row.querySelector('.refund-item__qty-input');
            cb.addEventListener('change', function () {
              if (cb.checked) {
                qtyInput.disabled = false;
              } else {
                qtyInput.disabled = true;
              }
            });
          });

          form.addEventListener('submit', async function (e) {
            e.preventDefault();
            errorBox.hidden = true;

            var reason = document.getElementById('refund-reason').value;
            if (!reason) { errorBox.textContent = 'Please select a reason.'; errorBox.hidden = false; return; }

            var items = [];
            modal.querySelectorAll('.refund-item__check:checked').forEach(function (cb) {
              var row = cb.closest('.refund-item');
              var qty = parseInt(row.querySelector('.refund-item__qty-input').value, 10) || 0;
              if (qty > 0) {
                items.push({ lineItemId: cb.dataset.lineId, quantity: qty });
              }
            });
            if (items.length === 0) {
              errorBox.textContent = 'Select at least one item.';
              errorBox.hidden = false;
              return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting…';

            try {
              var numericOrder = String(orderId).split('/').pop();
              var res = await fetch(workerBase + '/orders/' + numericOrder + '/request-refund', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Customer-Signature': customerSig
                },
                body: JSON.stringify({
                  customerId: customerId,
                  reason: reason,
                  items: items,
                  notes: document.getElementById('refund-notes').value
                })
              });
              var json = await res.json();
              if (!res.ok || !json.success) {
                throw new Error(json.error || json.message || ('HTTP ' + res.status));
              }
              form.hidden = true;
              success.hidden = false;
            } catch (err) {
              errorBox.textContent = err.message || 'Failed to submit refund request.';
              errorBox.hidden = false;
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit Request';
            }
          });
        })();
      </script>
    {% endif %}

  </div>
</div>

<style>
  /* Refund banner */
  .refund-banner {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--border-color);
    border-left-width: 3px;
    background: #fff;
  }
  .refund-banner--pending   { border-left-color: var(--signal-amber); background: #fffbeb; }
  .refund-banner--rejected  { border-left-color: var(--racing-red); background: #fef2f2; }
  .refund-banner--approved  { border-left-color: var(--signal-green); background: #f0fdf4; }
  .refund-banner--cancelled { border-left-color: #9ca3af; background: #f9fafb; }
  .refund-banner__icon { flex-shrink: 0; color: var(--signal-amber); padding-top: 1px; }
  .refund-banner--rejected  .refund-banner__icon { color: var(--racing-red); }
  .refund-banner--approved  .refund-banner__icon { color: var(--signal-green); }
  .refund-banner--cancelled .refund-banner__icon { color: #6b7280; }
  .refund-banner__title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #92400e;
  }
  .refund-banner--rejected  .refund-banner__title { color: #991b1b; }
  .refund-banner--approved  .refund-banner__title { color: #14532d; }
  .refund-banner--cancelled .refund-banner__title { color: #374151; }

  /* Refund history */
  .refund-history {
    border: 1px solid var(--border-color);
    background: #fff;
  }
  .refund-history__summary {
    cursor: pointer;
    list-style: none;
    padding: 12px 16px;
    font-size: 11px;
    color: var(--data-grey);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    user-select: none;
  }
  .refund-history__summary::-webkit-details-marker { display: none; }
  .refund-history__summary::before {
    content: '▸';
    margin-right: 8px;
    color: var(--racing-red);
    transition: transform 0.15s ease;
    display: inline-block;
  }
  .refund-history[open] .refund-history__summary::before {
    transform: rotate(90deg);
  }
  .refund-history__list {
    border-top: 1px solid var(--border-color);
    padding: 8px 16px 12px;
  }
  .refund-history__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border-color);
    font-size: 12px;
  }
  .refund-history__item:last-child { border-bottom: none; }
  .refund-history__pill {
    display: inline-block;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .refund-history__pill.is-pending   { background: #fef3c7; color: #92400e; }
  .refund-history__pill.is-rejected  { background: #fee2e2; color: #991b1b; }
  .refund-history__pill.is-approved  { background: #dcfce7; color: #14532d; }
  .refund-history__pill.is-cancelled { background: #f3f4f6; color: #374151; }
  .refund-history__meta {
    color: var(--data-grey);
    font-size: 11px;
  }
  .refund-banner__sub {
    font-size: 12px;
    color: #4b5563;
    margin-top: 4px;
    line-height: 1.5;
  }
  .refund-banner__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .refund-banner__cancel-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: #fff;
    color: #92400e;
    border: 1px solid #fcd34d;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .refund-banner__cancel-btn:hover {
    background: #fffbeb;
    border-color: #f59e0b;
  }
  .refund-banner__cancel-btn:disabled {
    opacity: 0.6; cursor: not-allowed;
  }

  /* Refund modal */
  .refund-modal {
    border: none;
    padding: 0;
    background: transparent;
    max-width: none;
    width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
  }
  .refund-modal::backdrop { background: rgba(0,0,0,0.55); backdrop-filter: blur(4px); }
  .refund-modal[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(20px, 6vh, 80px) 16px 16px;
  }
  .refund-modal__panel {
    background: #fff;
    border: 1px solid var(--border-color);
    width: 100%;
    max-width: 640px;
    max-height: 88dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: rmIn 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes rmIn {
    from { opacity: 0; transform: translateY(-12px) scale(0.985); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .refund-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 18px 22px;
    border-bottom: 1px solid var(--border-color);
  }
  .refund-modal__eyebrow {
    font-size: 10px;
    color: var(--racing-red);
    letter-spacing: 0.2em;
    font-weight: 700;
  }
  .refund-modal__title {
    font-size: 18px;
    font-weight: 700;
    margin-top: 4px;
  }
  .refund-modal__close {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--data-grey);
    padding: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .refund-modal__close:hover { color: var(--racing-red); border-color: var(--racing-red); }

  .refund-modal__body {
    padding: 18px 22px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .refund-field { display: flex; flex-direction: column; gap: 6px; }
  .refund-field__label {
    font-size: 10px;
    color: var(--racing-red);
    letter-spacing: 0.16em;
    font-weight: 700;
  }
  .refund-field__input {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid var(--border-color);
    background: #fff;
    color: var(--obsidian);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    transition: border-color 0.15s ease;
  }
  .refund-field__input:focus { border-color: var(--racing-red); outline: none; }
  .refund-field__textarea { resize: vertical; min-height: 64px; line-height: 1.5; }

  .refund-items { display: flex; flex-direction: column; gap: 8px; }
  .refund-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    background: #fff;
  }
  .refund-item:hover { border-color: var(--racing-red); }
  .refund-item[data-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
  .refund-item__check { accent-color: var(--racing-red); width: 16px; height: 16px; flex-shrink: 0; }
  .refund-item__main { flex: 1; min-width: 0; }
  .refund-item__title { font-size: 13px; font-weight: 600; color: var(--obsidian); line-height: 1.3; }
  .refund-item__meta { font-size: 11px; color: var(--data-grey); margin-top: 3px; letter-spacing: 0.02em; }
  .refund-item__qty { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
  .refund-item__qty-label { font-size: 9px; color: var(--data-grey); letter-spacing: 0.14em; }
  .refund-item__qty-input {
    width: 60px;
    padding: 5px 8px;
    border: 1px solid var(--border-color);
    text-align: center;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    background: #fff;
  }
  .refund-item__qty-input:disabled { opacity: 0.4; }

  .refund-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 10px 12px;
    font-size: 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }

  .refund-modal__footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding-top: 4px;
  }

  .refund-success {
    padding: 36px 24px 28px;
    text-align: center;
  }
  .refund-success__icon { color: var(--signal-green); margin-bottom: 14px; display: flex; justify-content: center; }
  .refund-success__title { font-size: 14px; font-weight: 700; letter-spacing: 0.16em; }
  .refund-success__sub { font-size: 13px; color: var(--data-grey); margin: 8px 0 18px; line-height: 1.5; }
</style>

{% schema %}
{
  "name": "Order Protocol",
  "tag": "section"
}
{% endschema %}
